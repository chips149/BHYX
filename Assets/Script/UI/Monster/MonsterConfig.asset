  list:
  - imgPath: UI/Codex/Monster/MonsterHeadIcon/FireMonster
    name: "\u5C0F\u706B\u602A"
    hp: "\u57FA\u7840\u8840\u91CF\u4E0D\u56FA\u5B9A"
    trait: "\u65E0"
    intro: "\u5C71\u6D77\u4E16\u754C\u8BDE\u751F\u4E4B\u521D\u706B\u7130\u5143\u7D20\u5E7B\u5316\u7684\u706B\u7075\u3002"
  - imgPath: UI/Codex/Monster/MonsterHeadIcon/Phoenix
    name: "\u51E4\u51F0"
    hp: "\u57FA\u7840\u8840\u91CF:3"
    trait: "\u63D0\u524D3\u884C\u51B2\u51FB\u6805\u680F"
    intro: "\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u4E39\u7A74\u5C71\u6709\u795E\u9E1F\u540D\u51E4\u51F0\uFF0C\u96C6\u65E5\u6708\u4E4B\u534E\u3001\u6C90\u68A7\u6850\u6E05\u9732\u800C\u751F\uFF0C\u5B88\u7075\u8109\u79D8\u5883\uFF0C\u4E94\u767E\u5E74\u4E00\u6D74\u706B\u6D85\u69C3\u3002 "
  - imgPath: UI/Codex/Monster/MonsterHeadIcon/JingCu
    name: "\u7206\u70B8\u6676\u7C07"
    hp: "\u57FA\u7840\u8840\u91CF:3"
    trait: "\u653B\u51FB\u4F1A\u70B9\u71C3\u6805\u680F\uFF0C\u76F4\u5230\u88AB\u6C34\u70AE\u7184\u706D"
    intro: "\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u708E\u706B\u5C71\u85CF\u5947\u6676\uFF0C\u5438\u5730\u8109\u623E\u6C14\u4E0E\u91D1\u77F3\u4E4B\u7CBE\u51DD\u7ED3\u800C\u6210\u3002\u89E6\u78B0\u5373\u7206\u3001\u788E\u6676\u56DB\u6E85\uFF0C\u4E3A\u79D8\u5883\u5929\u7136\u5F02\u602A\uFF0C\u4EA6\u85CF\u7834\u9635\u80FD\u91CF"
  - imgPath: UI/Codex/Monster/MonsterHeadIcon/Monkey
    name: "\u6731\u538C"
    hp: "\u57FA\u7840\u8840\u91CF:4"
    trait: "\u670960%\u7684\u6982\u7387\u95EA\u907F\u73A9\u5BB6\u653B\u51FB"
    intro: "\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u5C0F\u6B21\u5C71\u6709\u51F6\u517D\u6731\u538C\uFF0C\u72B6\u5982\u733F\u3001\u767D\u9996\u8D64\u8DB3\uFF0C\u4F34\u767D\u7389\u8D64\u94DC\u800C\u5C45\u3002\u5B83\u4E3A\u5175\u71F9\u4E4B\u5146\uFF0C\u73B0\u8EAB\u5373\u5F15\u5929\u4E0B\u6218\u4E71\u3002 "
  - imgPath: UI/Codex/Monster/MonsterHeadIcon/Dog
    name: "\u7978\u6597"
    hp: "\u57FA\u7840\u8840\u91CF:6"
    trait: "\u884C\u5F84\u540E\u6EDE\u7559\u5730\u9762\u70C8\u706B\uFF0C\u5176\u4F59\u5F02\u517D\u89E6\u78B0\u56DE\u8840"
    intro: "\u300A\u5C71\u6D77\u7ECF\u300B\u538C\u706B\u56FD\u85CF\u51F6\u517D\u7978\u6597\uFF0C\u72B6\u5982\u7384\u72AC\u3001\u904D\u4F53\u6D41\u5149\uFF0C\u4EE5\u706B\u4E3A\u98DF\u3001\u7CAA\u4EA6\u6210\u7130\u3002\u5B83\u76D8\u8E1E\u708E\u706B\u79D8\u5883\uFF0C\u55B7\u7130\u711A\u5C3D\u6765\u8005\u3002 "
  - imgPath: UI/Codex/Monster/MonsterHeadIcon/BOSS
    name: "\u538C\u706B"
    hp: "\u57FA\u7840\u8840\u91CF:200"
    trait: "\u62E5\u6709\u5FA1\u6C34\u7F69\uFF0C\u900F\u652F\u751F\u547D\u53EC\u5524\u706B\u7075"
    intro: "\u300A\u5C71\u6D77\u7ECF\u30FB\u6D77\u5916\u5357\u7ECF\u300B\u8F7D\u538C\u706B\u56FD\u5F02\u517D\u538C\u706B\uFF0C\u72B6\u4F3C\u9ED1\u733F\u3001\u517D\u8EAB\u8986\u6BDB\uFF0C\u4EE5\u70AD\u4E3A\u98DF\u3001\u53E3\u5410\u70C8\u7130\u3002\u76D8\u8E1E\u708E\u706B\u79D8\u5883\u5B88\u62A4\u706B\u6838\u3002 "
