    characterSetSelectionMode: 8
    characterSequence: "\u5DDD\u6E1F\u5370\u7B49\u7EA7\r\n\u6BCF3\u6B21\u653B\u51FB\u843D\u5370\r\n\u653B\u51FB\u529B+25%\u4FEE\u6539\u3001\u653B\u51FB\u95F4\u9694+25%\u4FEE\u6539\r\n\r\n\u6CA7\u6D77\u8861\r\n\u9AD8\u989D\u4F24\u5BB3\u52A0\u6210\r\n\u66B4\u51FB+50%\u4FEE\u6539\u3001\u66B4\u51FB\u4F24\u5BB3+50%\u4FEE\u6539\r\n\u78A7\u6CE2\u73CF\r\n\u6BCF\u6B21\u7A7A\u67AA\u4E0B\u4E00\u67AA\u4F24\u5BB3+1\r\n\u653B\u51FB\u95F4\u9694+50%\u4FEE\u6539\r\n\u57FA\u7840\u8840\u91CF\u4E0D\u56FA\u5B9A\r\n\u63D0\u524D3\u884C\u51B2\u51FB\u6805\u680F\r\n\u670960%\u95EA\u907F\uFF0C\u6BCF\u6B21\u95EA\u907F-20%\u95EA\u907F\u6982\u7387\u4E14\u5411\u540E\u53D1\u5C04\u4E00\u9897\u5C0F\u6C34\u6EF4\r\n\u653B\u51FB\u4F1A\u70B9\u71C3\u5267\u5236\u4F5C\u65B9\uFF1A\r\n\u5236\u4F5C\u65B9\uFF1A\r\n\u5409\u6797\u52A8\u753B\u5B66\u9662\u6E38\u620F\u5B66\u9662-\u6E38\u620F\u5B75\u5316\u56E2\u961F\r\n\u53D1\u884C\u65B9\uFF1A\r\n\u5409\u6797\u5409\u52A8\u76D8\u53E4\u7F51\u7EDC\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\r\n\u9879\u76EE\u603B\u8D1F\u8D23\u4EBA\uFF1A\u5B89\u5B81\r\n\u6267\u884C\u8D1F\u8D23\u4EBA\uFF1A\u674E\u5CA9\r\n=========\u9879\u76EE\u7EC4\u6210\u5458==========\r\n\u9879\u76EE\u6307\u5BFC\u6559\u5E08\uFF1A\u674E\u5CA9\u3001\u71D5\u9752\r\n\u7B56\u5212\u8D1F\u8D23\u4EBA\uFF1A\u6BD5\u98DE\u6768 
      \u7F8E\u672F\u8D1F\u8D23\u4EBA\uFF1A\u71D5\u9752\r\n\u7A0B\u5E8F\u8D1F\u8D23\u4EBA\uFF1A\u5F20\u99A8\u6708\r\n\u7B56\u5212\u7EC4\uFF1A\u738B\u4E49\u535A\u3001\u6BD5\u98DE\u6768\r\n\u7F8E\u672F\u7EC4\uFF1A\u6BDB\u5B87\u6167\u3001\u5510\u57F9\u96EF\u3001\u9648\u6CEF\u6C5F\u3001\r\n\u5F20\u4F51\u8BDA\u3001\u9AD8\u57F9\u5C27\u3001\u53F6\u598D\u82B3\u3001\u71D5\u9752\r\n\u7A0B\u5E8F\u7EC4\uFF1A\u5F20\u99A8\u6708\u3001\u6BCD\u6653\u83F2\u3001\u674E\u5CA9\u3001\u90D1\u4F1F\u4E1C\r\n=======\u6E38\u620F\u5B75\u5316\u56E2\u961F\u6210\u5458========\r\n\u7B56\u5212\u56E2\u961F\uFF1A\u674E\u5CA9\u3001\u738B\u4E49\u535A\u3001\u6BD5\u98DE\u6768\u3001\u82D7\u632F\u626C\u3001\u5173\u68EE\r\n\u4E8C\u7EF4\u7F8E\u672F\u56E2\u961F\uFF1A\u71D5\u9752\u3001\u6BDB\u5B87\u6167\r\n\u4E09\u7EF4\u7F8E\u672F\u56E2\u961F\uFF1A\u9AD8\u57F9\u5C27\r\n\u7279\u6548\u56E2\u961F\uFF1A\u53F6\u598D\u82B3\u3001\u5510\u57F9\u96EF\u3001\u5F20\u4F51\u57CE\r\n\u52A8\u4F5C\u56E2\u961F\uFF1A\u9648\u6CEF\u6C5F\r\n\u7A0B\u5E8F\u56E2\u961F\uFF1A\u5F20\u99A8\u6708\u3001\u90DD\u771F\u61FF\u3001\u6BCD\u6653\u83F2\u3001\r\n\u674E\u5353\u6F8E\u3001\u8303\u7EAF\u4F51\r\n\u97F3\u4E50\u97F3\u6548\u7EC4\uFF1A\u5173\u68EE\u3001\u82D7\u632F\u626C\u3001\u738B\u4E49\u535A\u3001\u6BD5\u98DE\u6768\r\n\u97F3\u4E50\u97F3\u6548\u7EC4\uFF1A\u6BD5\u98DE\u6768\r\n=======\u7279\u522B\u9E23\u8C22========\r\n\u90D1\u4F1F\u4E1C\u5148\u751F\u5BF9\u8BE5\u9879\u76EE\u5236\u4F5C\u7684\u5927\u529B\u652F\u6301\uFF01\r\n\r\n\r\n\r\n===\u611F\u8C22\u60A8\u7684\u6E38\u73A9\uFF0C\u795D\u60A8\u6E38\u620F\u6109\u5FEB\uFF01===\r\n\u706B\u7075\r\n\u57FA\u7840\u8840\u91CF\u4E0D\u56FA\u5B9A\r\n\u5C71\u6D77\u4E16\u754C\u8BDE\u751F\u4E4B\u521D\u706B\u7130\u5143\u7D20\u5E7B\u5316\u7684\u706B\u7075\u3002\r\n\r\n\u51E4\u51F0\r\n\u63D0\u524D3\u884C\u51B2\u51FB\u6805\u680F\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u4E39\u7A74\u5C71\u6709\u795E\u9E1F\u540D\u51E4\u51F0\uFF0C\u96C6\u65E5\u6708\u4E4B\u534E\u3001\u6C90\u68A7\u6850\u6E05\u9732\u800C\u751F\uFF0C\u5B88\u7075\u8109\u79D8\u5883\uFF0C\u4E94\u767E\u5E74\u4E00\u6D74\u706B\u6D85\u69C3\u3002\r\n\r\n\u6731\u538C\r\n\u670960%\u7684\u6982\u7387\u95EA\u907F\u73A9\u5BB6\u653B\u51FB\uFF0C\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u5C0F\u6B21\u5C71\u6709\u51F6\u517D\u6731\u538C\uFF0C\u72B6\u5982\u733F\u3001\u767D\u9996\u8D64\u8DB3\uFF0C\u4F34\u767D\u7389\u8D64\u94DC\u800C\u5C45\u3002\u5B83\u4E3A\u5175\u71F9\u4E4B\u5146\uFF0C\u73B0\u8EAB\u5373\u5F15\u5929\u4E0B\u6218\u4E71\u3002\r\n\r\n\u7206\u70B8\u6676\u7C07\r\n\u653B\u51FB\u4F1A\u70B9\u71C3\u6805\u680F\uFF0C\u76F4\u5230\u88AB\u6C34\u70AE\u7184\u706D\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u708E\u706B\u5C71\u85CF\u5947\u6676\uFF0C\u5438\u5730\u8109\u623E\u6C14\u4E0E\u91D1\u77F3\u4E4B\u7CBE\u51DD\u7ED3\u800C\u6210\u3002\u89E6\u78B0\u5373\u7206\u3001\u788E\u6676\u56DB\u6E85\uFF0C\u4E3A\u79D8\u5883\u5929\u7136\u5F02\u602A\uFF0C\u4EA6\u85CF\u7834\u9635\u80FD\u91CF\u3002\r\n\r\n\u7978\u6597\r\n\u884C\u5F84\u540E\u6EDE\u7559\u5730\u9762\u70C8\u706B\uFF0C\u5176\u4F59\u5F02\u517D\u89E6\u78B0\u56DE\u8840\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u538C\u706B\u56FD\u85CF\u51F6\u517D\u7978\u6597\uFF0C\u72B6\u5982\u7384\u72AC\u3001\u904D\u4F53\u6D41\u5149\uFF0C\u4EE5\u706B\u4E3A\u98DF\u3001\u7CAA\u4EA6\u6210\u7130\u3002\u5B83\u76D8\u8E1E\u708E\u706B\u79D8\u5883\uFF0C\u55B7\u7130\u711A\u5C3D\u6765\u8005\u3002\r\n\r\n\u538C\u706B\r\n\u62E5\u6709\u5FA1\u6C34\u7F69\uFF0C\u900F\u652F\u751F\u547D\u53EC\u5524\u706B\u7075\r\n\u300A\u5C71\u6D77\u7ECF\u30FB\u6D77\u5916\u5357\u7ECF\u300B\u8F7D\u538C\u706B\u56FD\u5F02\u517D\u538C\u706B\uFF0C\u72B6\u4F3C\u9ED1\u733F\u3001\u517D\u8EAB\u8986\u6BDB\uFF0C\u4EE5\u70AD\u4E3A\u98DF\u3001\u53E3\u5410\u70C8\u7130\u3002\u76D8\u8E1E\u708E\u706B\u79D8\u5883\u5B88\u62A4\u706B\u6838\u3002\r\n\r\n\r\n\r\n\u6CD5\u5B9D\u6587\u672C\r\n\r\n\u6CA7\u6D77\u8861\r\n\u3010\u4E3B\u52A8\u3011\u70B9\u51FB\u89D2\u8272\u5411\u524D\u65B9\u53D1\u5C04\u6D77\u6D6A\uFF0C\u6240\u6709\u654C\u4EBA\u53D7\u523010\u70B9\u4F24\u5BB3\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u5E7D\u90FD\u5C71\u5BD2\u6E0A\u5B55\u6B64\u7075\u846B\uFF0C\u51DD\u5730\u8109\u9634\u5BD2\u7075\u6DB2\u800C\u6210\uFF0C\u7EA2\u7EF3\u91D1\u94C3\u5C01\u5176\u7075\u529B\uFF0C\u53EF\u50A8\u7075\u6CC9\u5FA1\u90AA\u7130\uFF0C\u662F\u79D8\u5883\u7834\u708E\u7634\u7684\u5173\u952E\u79D8\u5B9D\u3002\r\n\r\n\u78A7\u6CE2\u73CF\r\n\u3010\u88AB\u52A8\u3011\u6BCF\u6B21\u7A7A\u70AE\u4E0B\u4E00\u53D1\u4F24\u5BB3\uFF0B1\uFF0C\u51FB\u4E2D\u602A\u7269\u540E\u91CD\u7F6E\r\n\u300A\u5C71\u6D77\u7ECF\u30FB\u4E2D\u5C71\u7ECF\u300B\u7476\u5C71\u7389\u9AD3\u96D5\u6210\u87AD\u9F99\u4F69\uFF0C\u51DD\u4E0A\u53E4\u6F5C\u9F99\u6C14\u6210\u5F62\uFF0C\u80FD\u9547\u90AA\u715E\u3001\u5F15\u79D8\u5883\u7075\u8109\uFF0C\u662F\u63A2\u9669\u7834\u8FF7\u9635\u7684\u6838\u5FC3\u79D8\u5B9D\u3002\r\n\u5DDD\u6E1F\u5370\r\n\u3010\u88AB\u52A8\u3011\u6BCF3\u6B21\u653B\u51FB\u540E\u4F1A\u4EA7\u751F\u9644\u52A0\u653B\u51FB\uFF0C\u843D\u4E0B\u5370\u7AE0\r\n\u300A\u5C71\u6D77\u7ECF\u30FB\u5317\u6D77\u7ECF\u300B\u8F7D\u5317\u6D77\u7075\u8109\u5B55\u6B64\u9F99\u9F9F\u5B9D\u5668\uFF0C\u51DD\u7384\u9F9F\u6B8B\u9B42\u4E0E\u6C34\u7CBE\u6676\u800C\u6210\uFF0C\u9547\u79D8\u5883\u6C34\u8109\uFF0C\u53EF\u5FA1\u6D2A\u5384\u3001\u7834\u6C34\u969C\uFF0C\u662F\u63A2\u6C34\u5883\u7684\u6838\u5FC3\u79D8\u5B9D\u3002\r\n\r\n\r\n\r\n\u5218\u5F66\u5F64\u3001\u674E\u81EA\u7136\u3001\u9093\u601D\u701A\u3001\u6731\u777F\u3001\u5F20\u8096\u6653\r\n\u5F20\u65ED\u4E1C\r\n\u4E09\u7EF4\u7F8E\u672F\u56E2\u961F\uFF1A\u6C88\u5168\u8FB0\u3001\u4F55\u65B0\u5B87\u3001\u5F20\u6770\r\n\u5468\u51EF\u3001\u9AD8\u57F9\u5C27\uFF0C\u9648\u5EAD\u83F2\uFF0C\u4ED8\u745C\uFF0C\u725B\u7389\u7476\r\n\u52A8\u4F5C\u56E2\u961F\uFF1A\u9E7F\u797A\u6657\u3001\u674E\u79B9\u7476\u3001\u9648\u6CEF\u6C5F\r\n\u5F20\u4EA6\u975E\u3001\u53F6\u598D\u82B3\u3001\u6BDB\u5B87\u6167\r\n\u7279\u6548\u56E2\u961F\uFF1A\u674E\u660C\u4E00\u3001\u8D56\u6210\u9F99\r\n\u5510\u57F9\u96EF\r\n\u7A0B\u5E8F\u56E2\u961F\uFF1A\u738B\u82F1\u5409\u3001\u5F20\u742A\u79C0\u6167\r\n\u5F20\u99A8\u6708\u3001\u90DD\u771F\u61FF\u3001\u6BCD\u6653\u83F2\u3001\u674E\u5353\u6F8E\u3001\u674E\u7490\r\n\u8303\u7EAF\u4F51\r\n\u97F3\u4E50\u97F3\u6548\u7EC4\uFF1A\u738B\u4E49\u535A\r\n=======\u7279\u522B\u9E23\u8C22========\r\n\u90D1\u4F1F\u4E1C\u5148\u751F\u5BF9\u8BE5\u9879\u76EE\u5236\u4F5C\u7684\u5927\u529B\u652F\u6301\uFF01\r\n\r\n\r\n\r\n===\u611F\u8C22\u60A8\u7684\u6E38\u73A9\uFF0C\u795D\u60A8\u6E38\u620F\u6109\u5FEB\uFF01===\u70C8\u71C3\u70E7\u540E\u6D88\u5931\r\n\u5316\u4F5C\u706B\u77E2\u540E\u5C04\u5411\u6805\u680F\u300A\u6D77\u7ECF\u300B\r\n\u8F7D\u4E39\u7A74\u5C71\u98DE\u6709\u795E\u9E1F\u540D\u98CE\u51F0\uFF0C\u96C6\u65E5\r\n\u6708\u4E4B\u534E\u3001\u6C90\u68A7\u6850\u6E05\u9732\u800C\u751F.\u5BF8\u7075\u8109\u79D2\u5883\u3002\r\n\u4E94\u767E\u5E74\u4E00\u6D74\u706B\u661F\u6A0A\u3002\r\n\r\n\u5316\u4F5C\u706B\u7130\u540E\u51B2\u51FB\u6805\u680F\r\n\u7206\u70B8\r\n\u5316\u4F5C\u706B\u7130\u540E\u51B2\u51FB\u6805\u680F\u6805\u680F\uFF0C\u76F4\u5230\u88AB\u6C34\u70AE\u7184\u706D\r\n\u8D70\u8FC7\u7684\u8DEF\u9762\u4F1A\u88AB\u70B9\u71C3\uFF0C\u70B9\u71C3\u7684\u8DEF\u9762\u4F1A\u4F7F\u602A\u7269\u56DE\u8840\r\n\r\n\u7206\u70B8\u6676\u851F\u7206\u70B8\u6676\u851F\r\n\u57FA\u7840\u8840\u91CF\uFF1A3\r\n\u602A\u7269\u7279\u6027\uFF1A\u653B\u51FB\u70B9\u71C3\u6805\u680F\uFF0C\u76F4\u5230\u6C34\u70AE\u706D\u706B\r\n\u300A\u821EUTU\u300B\u300B\r\n\u8F7D\u708E\u706B\u5C71\u85CF\u5947\u6676\u3002\u5438\u5730\u8109\u623F\u6C14\r\n\u4E0E\u91D1\u77F3\u4E4B\u7CBE\u51DD\u7ED3\u800C\u6210\u3002\u89E6\u78B0\u5373\u7206\u3001\u788E\u6676\u5339\r\n\u6E85\uFF0C\u4E3A\u79D8\u5883\u5929\u7136\u5F02\u602A\uFF0C\u4EA6\u85CF\u7834\u9635\u80FD\u91CF\r\n\r\n\u57FA\u7840\u8840\u91CF\uFF1A3\u5C0F\u706B\u602A\r\n\u706B\u51E4\u51F0\r\n\u6731\u538C\r\n\u7206\u70B8\u6676\u7C07\r\n\u7978\u6597\u602A\u7269\u7279\u6027\uFF1A\u653B\u51FB\u70B9\u71C3\u6805\u680F\uFF0C\u76F4\u5230\u6C34\u70AE\u706D\u706B\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u708E\u706B\u5C71\u85CF\u5947\u6676\u3002\u5438\u5730\u8109\u623F\u6C14\u4E0E\u91D1\u77F3\u4E4B\u7CBE\u51DD\u7ED3\u800C\u6210\u3002\u89E6\u78B0\u5373\u7206\u3001\u788E\u6676\u5339\u6E85\uFF0C\u4E3A\u79D8\u5883\u5929\u7136\u5F02\u602A\uFF0C\u4EA6\u85CF\u7834\u9635\u80FD\u91CF\u706B\u82D7\u72B6\u57FA\u7840\u5C0F\u706B\u602A\t\u4E00\u7C07\u706B\u82D7\r\n\u6BD5\u65B9\t\u71C3\u70E7\u7740\u706B\u7130\u7684\u9E1F\r\n\u6731\u538C\t\u4E00\u53EA\u8EAB\u4E0A\u5E26\u706B\u82D7\u7684\u7334\u5B50\r\n\u7EA2\u8272\u77FF\u77F3\t\u7531\u706B\u7130\u7ED3\u6676\u6784\u6210\u7684\u7C7B\u77FF\u77F3\u6676\u4F53\u72B6\u602A\u7269\r\n\u7978\u6597\t\u5916\u5F62\u5982\u9ED1\u72AC\uFF0C\u4F46\u4EE5\u706B\u7130\u4E3A\u98DF\u3002\u8EAB\u4F53\u7531\u6697\u7EA2\u8272\u70BD\u70AD\u6784\u6210\uFF0C\u5954\u8DD1\u65F6\u706B\u661F\u56DB\u5C04\r\n\u5FEB\u901F\u88C5\u586B\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+15%  
      \r\n\u66B4\u51FB\u4F24\u5BB3+10%\r\n\u653B\u51FB\u95F4\u9694+5%\u653B\u51FB\u529B\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u6570\u91CF\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u5927\u5C0F\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u7A7F\u900F\r\n\u66B4\u51FB\u7387+10%\r\n\u653B\u51FB\u529B+3\r\n\u5B50\u5F39\u5927\u5C0F+15%\r\n\u653B\u51FB\u529B+3\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6-10%\r\n\u66B4\u51FB\u4F24\u5BB3+20%\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+5%\r\n\u5B50\u5F39\u5927\u5C0F-10%\r\n\u6563\u5E03\u8303\u56F4max-15%\r\n\u8840\u91CF-5\r\n\u5B50\u5F39\u4E0A\u9650+3\r\n\u8840\u91CF+10\r\n\u6563\u5E03\u8303\u56F4min+10%\r\n\u653B\u51FB+5\r\n\u653B\u51FB\u95F4\u9694+5%\r\n\u5B50\u5F39\u5927\u5C0F-5%\r\n\u653B\u51FB\u95F4\u9694-15%\r\n\u5B50\u5F39\u4E0A\u9650+1\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+15%\r\n\u66B4\u51FB\u4F24\u5BB3+10%\r\n\u653B\u51FB\u95F4\u9694+5%\r\n\u653B\u51FB\u95F4\u9694\r\n\u5B50\u5F39\u4E0A\u9650\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6\r\n\u5B50\u5F39\u5927\u5C0F\r\n\u6563\u5E03\u8303\u56F4max\u602A\u7269\u6BCF\u6B21\u53D7\u51FB\u670920%\u6982\u7387\u5728\u4E00\u4E2A\u521D\u59CB\u65B9\u5411\u53D1\u5C041\u9897\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\r\n\u5B50\u5F39\u4E0A\u9650-1\r\n\u968F\u673A\u4E00\u4E2A\u521D\u59CB\u65B9\u5411\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u6570\u91CF+1\r\n\u66B4\u51FB\u7387+10%\r\n\u5C06\u6240\u6709\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u5411\u968F\u673A\u540C\u4E00\u65B9\u5411\u53D1\u5C04\r\n\u6563\u5E03\u8303\u56F4max+10%\r\n\u5B50\u5F39\u5927\u5C0F-15%\r\n\u5F53\u573A\u4E0A\u5B58\u572810\u4E2A\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u65F6\uFF0C\u4E0B\u4E00\u6B21\u653B\u51FB70%\u4E0D\u6D88\u8017\u5F39\u836F\r\n\u653B\u51FB\u95F4\u9694-15%\r\n\u66B4\u51FB\u4F24\u5BB3+10%\r\n\u4E0B\u4E00\u6B21\u9009\u5361\u65F6\u53EF\u4EE5\u9009\u62E93\u6B21\r\n\u8840\u91CF+5\r\n\u56DE\u590D50%\u8840\u91CF\r\n\u6563\u5E03\u8303\u56F4min+20%\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F3920%\u643A\u5E26\u96F7\u7535\uFF0C\u51FB\u4E2D\u706B\u602A\u540E\u9020\u6210\u8303\u56F4\u7206\u70B8\uFF0C\u7206\u70B8\u4F24\u5BB3\u4E3A\u5B50\u5F39\u768410%\r\n\u6563\u5E03\u8303\u56F4min-20%\r\n\u66B4\u51FB\u7387+10%\r\n\u6700\u540E2\u9897\u7684\u6C34\u7403\u843D\u70B9\u5C06\u5404\u751F\u6210\u4E00\u4E2A\u6700\u591A\u5B58\u57283s\u7684\u3010\u951A\u70B9\u3011\r\n\u6563\u5E03\u8303\u56F4max-10%\u731B\u51FB\r\n\r\n\u8D85\u5927\u5F39\r\n\r\n\r\n\u7CBE\u5999\u5B50\u5F39\r\n\r\n\r\n\u7CBE\u51C6\r\n\r\n\u6269\u5BB9\u5F39\u5939\r\n\r\n\r\n\u5F3A\u653B\r\n\r\n\r\n\u9AD8\u901F\u541F\u5531\r\n\r\n\u5FEB\u901F\u88C5\u586B\r\n\r\n\r\n\u538B\u7F29\u6C34\u5F39\r\n\r\n\u66F4\u591A\u98DE\u5F39\r\n\r\n\u540C\u5411\u98DE\u5F39\r\n\r\n\r\n\u98DE\u5F39\u56DE\u6536\r\n\r\n\r\n\u65E0\u4E2D\u751F\u6709\r\n\r\n\u75AF\u72C2\u94BB\u77F3\r\n\r\n\u96F7\u7F5A\r\n\r\n\r\n\u8FDE\u8FDE\u770B\r\n\r\n\r\n\u6751\u5E84\u82F1\u96C4\r\n\r\n\r\n\r\n\u597D\u591A\u4EBA\u554A\r\n\r\n\u602A\u7269\u53D7\u51FB\u6982\u7387\u53D1\u5C04\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\r\nBC-1\r\n\u589E\u52A0\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u6570\u91CF\r\nCR+10%\r\n\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u65B9\u5411\u7EDF\u4E00\r\nSM+10%\r\nBS-15%\r\n\u6709\u591A\u4E2A\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u65F6\uFF0C\u6982\u7387\u4E0D\u8017\u5F39\r\nAI-15%\r\nCD+10%\r\n\u4E0B\u4E00\u6B21\u9009\u5361\u65F6\u53EF\u4EE5\u9009\u62E93\u6B21\r\nHP+10\r\n\u56DE\u590D50%\u8840\u91CF\r\nSN+20%\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u5E26\u70B8\u96F7\r\nSN-20%\r\nCR+10%\r\n\u653B\u51FB\u843D\u70B9\u751F\u6210\u951A\u70B9\r\nSM-10%\u53D1\u5C04\u6C34\u70AE\t\u9AD8\u989D\u63D0\u5347\u52A0\u6210\t\u66B4\u51FB\u7387+50%\u4FEE\u6539\u3001\u66B4\u51FB\u4F24\u5BB3+50%\u4FEE\u6539\t\"\u653B\u51FB\u529B\uFF1A2\r\n\u653B\u51FB\u95F4\u9694\uFF1A10\r\n\u5B50\u5F39\u4E0A\u9650\uFF1A5\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6\uFF1A10\r\n\u5B50\u5F39\u5927\u5C0F\uFF1A5\r\n\u6805\u680F\u8840\u91CF\uFF1A35\r\n\u66B4\u51FB\u7387\uFF1A5%\r\n\u66B4\u51FB\u4F24\u5BB3\uFF1A+50%\r\n\u6563\u5E03\u8303\u56F4\uFF1A3~5\"\t\"\u653B\u51FB\u529B\uFF1A2=\u53471\u7EA7+2\u6CA7\u6D77\u8605\r\n\u78A7\u6CE2\u73CF\r\n\u5DDD\u6E1F\u5370\r\n\u653B\u51FB\u95F4\u9694\uFF1A10\u6E90\u81EA\u4E00\u79CD\u9970\u54C1\u6446\u4EF6\uFF0C\u7389\u846B\u82A6\r\n\"\u5F62\u8C61\u7075\u611F\uFF1A
      \u6E90\u81EA\u53E4\u4EE3\u7389\u793C\u5668\u201C\u7389\u73CF\u201D\u548C\u201C\u7389\u73AF\u201D\r\n\u7389\u73A6\u7684\u5F62\u8C61\u6539\u4E3A\u9C7C\"\r\n\u5F62\u8C61\u7075\u611F\uFF1A\_\u6E90\u81EA\u53E4\u4EE3\u5B98\u5370\u6216\u5C06\u519B\u5370\r\n\u5F62\u8C61\u7075\u611F\uFF1A\_\u5C06\u4F5B\u6559\u827A\u672F\u4E2D\u7684\u201C\u83B2\u76CF\u201D\u4E0E\u6C34\u6D41\u3001\u5149\u5F71\u7ED3\u5408\uFF0C\u521B\u9020\u51FA\u4E00\u4EF6\u4F18\u96C5\u800C\u795E\u5723\u7684\u6CD5\u5668\u3002\u5B50\u5F39\u4E0A\u9650\uFF1A5=\u53473\u7EA7+1\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6\uFF1A10=\u53473\u7EA7+1\r\n\u5B50\u5F39\u5927\u5C0F\uFF1A5\r\n\u6805\u680F\u8840\u91CF\uFF1A35=\u53471\u7EA7+3\r\n\u66B4\u51FB\u7387\uFF1A5%=\u53475\u7EA7+5%\r\n\u66B4\u51FB\u4F24\u5BB3\uFF1A+50%=\u53472\u7EA7+5%\r\n\u6563\u5E03\u8303\u56F4\uFF1A3~5\"\r\n\u53D1\u5C04\u6C34\u70AE\t\u6BCF\u6B21\u7A7A\u67AA\u4E0B\u4E00\u67AA\u4F24\u5BB3+1\t\u653B\u51FB\u95F4\u9694+50%\u4FEE\u6539\t\"\u653B\u51FB\u529B\uFF1A1\r\n\u653B\u51FB\u95F4\u9694\uFF1A5\r\n\u5B50\u5F39\u4E0A\u9650\uFF1A10\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6\uFF1A10\r\n\u5B50\u5F39\u5927\u5C0F\uFF1A5\r\n\u6805\u680F\u8840\u91CF\uFF1A30\r\n\u66B4\u51FB\u7387\uFF1A5%\r\n\u66B4\u51FB\u4F24\u5BB3\uFF1A+60%\r\n\u6563\u5E03\u8303\u56F4\uFF1A5~7\"\t\u540C\u4E0A\r\n\u53D1\u5C04\u6C34\u70AE\t\u6BCF3\u6B21\u653B\u51FB\u843D\u5370\t\u653B\u51FB\u529B+25%\u4FEE\u6539\u3001\u653B\u51FB\u95F4\u9694+25%\u4FEE\u6539\t\"\u653B\u51FB\u529B\uFF1A1\r\n\u653B\u51FB\u95F4\u9694\uFF1A10\r\n\u5B50\u5F39\u4E0A\u9650\uFF1A5\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6\uFF1A8\r\n\u5B50\u5F39\u5927\u5C0F\uFF1A5\r\n\u6805\u680F\u8840\u91CF\uFF1A25\r\n\u66B4\u51FB\u7387\uFF1A5%\r\n\u66B4\u51FB\u4F24\u5BB3\uFF1A+50%\r\n\u6563\u5E03\u8303\u56F4\uFF1A2~3\"\t\u540C\u4E0A\r\nCD+10%\r\n\u6740\u654C\u63D0\u5347NPC\u52A0\u6210\r\nBC-1\r\nHP+10\r\nBR+5%\r\n\u53EC\u5524\u7269\u8D8A\u591A\u653B\u51FB\u95F4\u9694\u8D8A\u5C0F\r\nHP+5\r\nAI-15%\r\n\u6BCF40\u79D2\u5237\u65B0\u6C34\u76FE\r\nAT-2\u3010\u951A\u70B9\u3011\u4E4B\u95F4\u4F1A\u81EA\u52A8\u8FDE\u7EBF\uFF0C\u602A\u7269\u7ECF\u8FC7\u8FDE\u7EBF\u9020\u62101\u70B9\u4F24\u5BB3\r\n\r\n\r\nBR+15%\r\n\u6740\u654C\u751F\u6210\u6F6E\u6C50\u55B7\u6CC9\r\nBC+2\r\nCD+20%\r\n\u6740\u654C\u6982\u7387\u751F\u6210\u6C34\u9F99\u5377\r\nCR+10%\r\nBS+15%\r\n\u540C\u66B4\u51FB\u6982\u7387BS++\r\nSM+20%\r\nSN+20%\r\n\u653B\u51FB\u5728\u6563\u5E03\u8303\u56F4\u5185\u9020\u6210\u989D\u5916\u4F24\u5BB3\r\nSM+30%\r\n\r\n\r\n\u6C34\u76FE\r\n\r\n\r\n\u6F6E\u6C50\u55B7\u6CC9\u5492\r\n\r\n\r\n\u6B7B\u4EA1\u9F99\u5377\r\n\r\n\r\n\u4E0D\u7A33\u5B9A\u5B50\u5F39\r\n\r\n\r\n\u51B7\u7738\r\n\r\n\r\n\r\n\r\n\u66B4\u51FB\u4F24\u5BB3+10%\r\n\u6BCF\u51FB\u674040\u4E2A\u654C\u4EBA\uFF0C\u6BCF\u4E2ANPC\u52A0\u6210+1\uFF08\u4E0A\u9650+3\uFF09\r\n\u5B50\u5F39\u4E0A\u9650-1\r\n\u8840\u91CF+10\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+5%\r\n\u573A\u4E0A\u6BCF\u6709\u4E00\u4E2A\u53EC\u5524\u7269\uFF0C\u653B\u51FB\u95F4\u9694-5%\u706B\u5149\u517D\r\n\u4E3A\u8EAB\u540E\u540C\u5217\u5F02\u517D\u63D0\u4F9B50%\u51CF\u4F24\r\n\u300A\u5C71\u6D77\u7ECF\u30FB\u795E\u5F02\u7ECF\u300B\u8F7D\u706B\u6797\u5C71\u706B\u5149\u517D\uFF0C\u5927\u5982\u9F20\uFF0C\u6BDB\u957F\u4E09\u56DB\u5BF8\uFF0C\u7EC6\u5982\u4E1D\uFF0C\u53EF\u4F5C\u706B\u6D63\u5E03\uFF0C\u4EE5\u706B\u70E7\u4E4B\u5373\u6E05\u3002\u6027\u6E29\u987A\uFF0C\u975E\u81EA\u613F\u96BE\u53D6\u6BDB\u3002\u8840\u91CF+5\r\n\u653B\u51FB\u95F4\u9694-15%\r\n\u6BCF40\u79D2\u5237\u65B0\u4E00\u6B21\u62B5\u6D8810\u4F24\u5BB3\u7684\u6C34\u76FE\r\n\u653B\u51FB\u529B-2\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+15%\r\n\u51FB\u6740\u602A\u7269\u670910%\u6982\u7387\u751F\u6210\u4E00\u4E2A\u5B58\u57285s\u7684\u6F6E\u6C50\u55B7\u6CC9\uFF0C\u602A\u7269\u89E6\u78B0\u4F1A\u88AB\u65BD\u52A0\u3010\u6F6E\u6E7F\u3011\r\n\u5B50\u5F39\u4E0A\u9650+2\r\n\u66B4\u51FB\u4F24\u5BB3+20%\r\n\u602A\u7269\u6B7B\u4EA1\u540E30%\u4F1A\u5411\u540E\u751F\u6210\u4E00\u4E2A\u4F24\u5BB3\u4E3A\u653B\u51FB\u529B20%\u6C34\u9F99\u5377\r\n\u66B4\u51FB\u7387+10%\r\n\u5B50\u5F39\u5927\u5C0F+15%\r\n\u6709\u548C\u66B4\u51FB\u7387\u76F8\u7B49\u7684\u6982\u7387\u4F7F\u5C04\u51FA\u70AE\u5F39\u5B50\u5F39\u5927\u5C0F+30%\r\n\u6563\u5E03\u8303\u56F4max+20%\r\n\u6563\u5E03\u8303\u56F4min+20%\r\n\u53D1\u5C04\u5B50\u5F39\u65F6\uFF0C\u5BF9\u6563\u5E03\u8303\u56F4\u5185\u6240\u6709\u654C\u4EBA\u9020\u6210\u4E00\u6B21\u653B\u51FB\u529B20%\u7684\u4F24\u5BB3\r\n\u6563\u5E03\u8303\u56F4max+30%\r\n\u6563\u5E03\u8303\u56F4min\r\n\u66B4\u51FB\u7387\r\n\u66B4\u51FB\u4F24\u5BB3\r\n\u8840\u91CF\r\n\r\n\u66F4\u65B0\u65E5\u671F\uFF1A2026\u5E744\u670823\u65E5\r\n\r\n\u751F\u6548\u65E5\u671F\uFF1A2026\u5E744\u670823\u65E5\r\n\r\n\u6B22\u8FCE\u4F7F\u7528\u7531\u5409\u6797\u5409\u52A8\u76D8\u53E4\u7F51\u7EDC\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\uFF08\u4EE5\u4E0B\u7B80\u79F0\"\u5409\u52A8\u76D8\u53E4\"\u6216\u201C\u6211\u4EEC\u201D\uFF09\u8FD0\u8425\u5F00\u53D1\u7684\u7F51\u7EDC\u6E38\u620F\u4EA7\u54C1\u53CA\u76F8\u5173\u670D\u52A1\u3002\u6211\u4EEC\u5BF9\u60A8\u53D1\u5E03\u5728\u4E92\u8054\u7F51\u4E0A\u7684\u4E2A\u4EBA\u4FE1\u606F\u975E\u5E38\u91CD\u89C6\uFF0C\u4EA6\u6DF1\u77E5\u8BE5\u7B49\u4E2A\u4EBA\u4FE1\u606F\u5BF9\u60A8\u7684\u91CD\u8981\u6027\u3002\u6211\u4EEC\u8BA4\u4E3A\u8BA9\u60A8\u4E86\u89E3\u6211\u4EEC\u5982\u4F55\u5904\u7406\u6211\u4EEC\u901A\u8FC7\u4E92\u8054\u7F51\u83B7\u5F97\u7684\u4E0E\u60A8\u6709\u5173\u7684\u4E2A\u4EBA\u4FE1\u606F\u662F\u975E\u5E38\u91CD\u8981\u7684\u3002\u6211\u4EEC\u5C06\u5C3D\u529B\u4FDD\u62A4\u60A8\u5728\u4F7F\u7528\u5409\u52A8\u76D8\u53E4\u7F51\u7AD9\u6216\u4EA7\u54C1\u8FC7\u7A0B\u4E2D\u5411\u6211\u4EEC\u63D0\u4F9B\u7684\u4E2A\u4EBA\u4FE1\u606F\uFF0C\u4EE5\u53CA\u60A8\u7684\u9690\u79C1\u5B89\u5168\u3002\u5982\u60A8\u4E3A\u672A\u6EE1\u5341\u56DB\u5468\u5C81\u7684\u7528\u6237\uFF0C\u5728\u9002\u7528\u300A\u5409\u52A8\u76D8\u53E4\u9690\u79C1\u653F\u7B56\u300B\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u672C\u300A\u9690\u79C1\u653F\u7B56\u300B\u201D\uFF09\u7684\u540C\u65F6\u5C06\u9002\u7528\u300A\u513F\u7AE5\u4E2A\u4EBA\u4FE1\u606F\u4FDD\u62A4\u6307\u5F15\u300B\uFF0C\u8BF7\u60A8\u7279\u522B\u5173\u6CE8\u3002\u4E0B\u6587\u7684\u201C\u60A8\u201D\u6216\u201C\u60A8\u201D\uFF0C\u82E5\u65E0\u7279\u522B\u8BF4\u660E\uFF0C\u5219\u6307\u4EE3\u672A\u6EE114\u5468\u5C81\u7528\u6237\u7684\u76D1\u62A4\u4EBA\u6216\u5DF2\u6EE114\u5468\u5C81\u7684\u7528\u6237\u3002\r\n\r\n\u672C\u300A\u9690\u79C1\u653F\u7B56\u300B\u5C06\u5E2E\u52A9\u60A8\u4E86\u89E3\uFF1A\r\n\r\n\u6211\u4EEC\u4F1A\u9075\u5FAA\u9690\u79C1\u653F\u7B56\u6536\u96C6\u3001\u4F7F\u7528\u60A8\u7684\u4FE1\u606F\uFF0C\u4F46\u4E0D\u4F1A\u4EC5\u56E0\u60A8\u540C\u610F\u672C\u300A\u9690\u79C1\u653F\u7B56\u300B\u800C\u91C7\u7528\u5F3A\u5236\u6346\u7ED1\u7684\u65B9\u5F0F\u4E00\u63FD\u5B50\u6536\u96C6\u4E2A\u4EBA\u4FE1\u606F\u3002\r\n\r\n\u5F53\u60A8\u4F7F\u7528\u6216\u5F00\u542F\u76F8\u5173\u529F\u80FD\u6216\u4F7F\u7528\u670D\u52A1\u65F6\uFF0C\u4E3A\u5B9E\u73B0\u529F\u80FD\u3001\u670D\u52A1\u6240\u5FC5\u9700\uFF0C\u6211\u4EEC\u4F1A\u6536\u96C6\u3001\u4F7F\u7528\u76F8\u5173\u4FE1\u606F\u3002\u9664\u975E\u662F\u4E3A\u5B9E\u73B0\u4E1A\u52A1\u529F\u80FD\u6216\u6839\u636E\u6CD5\u5F8B\u6CD5\u89C4\u8981\u6C42\u6240\u5FC5\u9700\u7684\u5FC5\u8981\u4FE1\u606F\uFF0C\u60A8\u5747\u53EF\u4EE5\u62D2\u7EDD\u63D0\u4F9B\u4E14\u4E0D\u5F71\u54CD\u5176\u4ED6\u529F\u80FD\u6216\u670D\u52A1\u3002\u6211\u4EEC\u5C06\u5728\u9690\u79C1\u653F\u7B56\u4E2D\u9010\u9879\u8BF4\u660E\u6240\u8981\u6536\u96C6\u7684\u4FE1\u606F\u3002\r\n\r\n\u4E3A\u5B9E\u73B0\u4E1A\u52A1\u529F\u80FD\u6216\u6839\u636E\u6CD5\u5F8B\u6CD5\u89C4\u8981\u6C42\u6240\u5FC5\u9700\uFF0C\u6211\u4EEC\u4F1A\u5728\u60A8\u4F7F\u7528\u7279\u5B9A\u529F\u80FD\u6216\u670D\u52A1\u65F6\u6536\u96C6\u3001\u4F7F\u7528\u60A8\u7684\u654F\u611F\u4E2A\u4EBA\u4FE1\u606F\u3002\r\n\r\n\u7CBE\u786E\u5730\u7406\u4F4D\u7F6E\u3001\u6444\u50CF\u5934\uFF08\u76F8\u673A\uFF09\u3001\u9EA6\u514B\u98CE\u3001\u76F8\u518C\uFF08\u5B58\u50A8\uFF09\uFF0C\u5747\u4E0D\u4F1A\u9ED8\u8BA4\u5F00\u542F\uFF0C\u53EA\u6709\u7ECF\u8FC7\u60A8\u7684\u660E\u793A\u6388\u6743\u624D\u4F1A\u5728\u4E3A\u5B9E\u73B0\u7279\u5B9A\u529F\u80FD\u6216\u670D\u52A1\u65F6\u4F7F\u7528\uFF0C\u60A8\u4E5F\u53EF\u4EE5\u64A4\u56DE\u6388\u6743\u3002\u7279\u522B\u9700\u8981\u6307\u51FA\u7684\u662F\uFF0C\u5373\u4F7F\u7ECF\u8FC7\u60A8\u7684\u6388\u6743\uFF0C\u6211\u4EEC\u83B7\u5F97\u4E86\u8FD9\u4E9B\u654F\u611F\u6743\u9650\uFF0C\u4E5F\u4E0D\u4F1A\u5728\u76F8\u5173\u529F\u80FD\u6216\u670D\u52A1\u4E0D\u9700\u8981\u65F6\u800C\u6536\u96C6\u60A8\u7684\u4FE1\u606F\u3002\r\n\r\n\u7533\u8BF7\u64CD\u4F5C\u6743\u9650\u5217\u8868\r\n\r\n\u4E3A\u4FDD\u969C\u6E38\u620F\u529F\u80FD\u5B9E\u73B0\u4E0E\u5B89\u5168\u7A33\u5B9A\u8FD0\u884C\u4E4B\u76EE\u7684\uFF0C\u6211\u4EEC\u53EF\u80FD\u4F1A\u7533\u8BF7\u6216\u4F7F\u7528\u64CD\u4F5C\u7CFB\u7EDF\u7684\u76F8\u5173\u6743\u9650\uFF1B\r\n\r\n\u4E3A\u4FDD\u969C\u60A8\u7684\u77E5\u60C5\u6743\uFF0C\u6211\u4EEC\u901A\u8FC7\u4E0B\u5217\u5217\u8868\u5C06\u6211\u4EEC\u53EF\u80FD\u7533\u8BF7\u3001\u4F7F\u7528\u7684\u76F8\u5173\u64CD\u4F5C\u7CFB\u7EDF\u6743\u9650\u8FDB\u884C\u5C55\u793A\uFF0C\u60A8\u53EF\u4EE5\u6839\u636E\u5B9E\u9645\u9700\u8981\u5BF9\u76F8\u5173\u6743\u9650\u8FDB\u884C\u7BA1\u7406\uFF1B\r\n\r\n\u6839\u636E\u4EA7\u54C1\u7684\u5347\u7EA7\uFF0C\u7533\u8BF7\u3001\u4F7F\u7528\u6743\u9650\u7684\u7C7B\u578B\u4E0E\u76EE\u7684\u53EF\u80FD\u4F1A\u6709\u53D8\u52A8\uFF0C\u6211\u4EEC\u5C06\u53CA\u65F6\u6839\u636E\u8FD9\u4E9B\u53D8\u52A8\u5BF9\u5217\u8868\u8FDB\u884C\u8C03\u6574\uFF0C\u4EE5\u786E\u4FDD\u60A8\u53CA\u65F6\u83B7\u6089\u6743\u9650\u7684\u7533\u8BF7\u4E0E\u4F7F\u7528\u60C5\u51B5\uFF1B\r\n\r\n\u8BF7\u60A8\u77E5\u6089\uFF0C\u6211\u4EEC\u4E3A\u4E1A\u52A1\u4E0E\u6E38\u620F\u7684\u529F\u80FD\u4E0E\u5B89\u5168\u9700\u8981\uFF0C\u6211\u4EEC\u53EF\u80FD\u4E5F\u4F1A\u4F7F\u7528\u7B2C\u4E09\u65B9SDK\uFF0C\u8FD9\u4E9B\u7B2C\u4E09\u65B9\u4E5F\u53EF\u80FD\u4F1A\u7533\u8BF7\u6216\u4F7F\u7528\u76F8\u5173\u64CD\u4F5C\u7CFB\u7EDF\u6743\u9650\uFF1B\r\n\r\n\u5728\u4F7F\u7528\u6E38\u620F\u4EA7\u54C1\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u60A8\u53EF\u80FD\u4F1A\u4F7F\u7528\u7B2C\u4E09\u65B9\u5F00\u53D1\u7684H5\u9875\u9762\u6216\u5C0F\u7A0B\u5E8F\uFF0C\u8FD9\u4E9B\u7B2C\u4E09\u65B9\u5F00\u53D1\u5F00\u53D1\u7684\u63D2\u4EF6\u6216\u5C0F\u7A0B\u5E8F\u4E5F\u53EF\u80FD\u56E0\u4E1A\u52A1\u529F\u80FD\u6240\u5FC5\u9700\u800C\u7533\u8BF7\u6216\u4F7F\u7528\u76F8\u5173\u64CD\u4F5C\u7CFB\u7EDF\u6743\u9650\u3002\r\n\r\n1\u3001\u83B7\u53D6\u60A8\u7684\u8BBE\u5907\u76F8\u5173\u4FE1\u606F\uFF0C\u5305\u62EC\u8BBE\u5907\u578B\u53F7\u3001\u64CD\u4F5C\u7CFB\u7EDF\u7248\u672C\uFF0C\u5305\u62EC\u6536\u96C6\u60A8\u7684\u8BBE\u5907
      Mac \u5730\u5740\u3001\u552F\u4E00\u8BBE\u5907\u8BC6\u522B\u7801\uFF08 IMEI/MEID/android
      ID/IDFA/OPENUDID/GUID \u3001 SIM \u5361 IMSI \u4FE1\u606F\uFF09\u4EE5\u63D0\u4F9B\u7EDF\u8BA1\u5206\u6790\u670D\u52A1\uFF0C\u5E76\u901A\u8FC7\u5730\u7406\u4F4D\u7F6E\u6821\u51C6\u62A5\u8868\u6570\u636E\u51C6\u786E\u6027\uFF0C\u63D0\u4F9B\u57FA\u7840\u53CD\u4F5C\u5F0A\u670D\u52A1\u3002\r\n\r\n2\u3001\u63D0\u4F9B\u8BFB\u53D6\u624B\u673A\u50A8\u5B58\u7A7A\u95F4\u5185\u6570\u636E\u7684\u529F\u80FD\uFF0C\u7528\u4E8EApp\u8BFB\u53D6\u5B58\u50A8\u4E2D\u7684\u56FE\u7247\u3001\u6587\u4EF6\u7B49\u5185\u5BB9\uFF0C\u4E3B\u8981\u7528\u4E8E\u5E2E\u52A9\u60A8\u53D1\u5E03\u4FE1\u606F\uFF0C\u5728\u672C\u5730\u8BB0\u5F55\u5D29\u6E83\u65E5\u5FD7\u4FE1\u606F\uFF08\u5982\u6709\uFF09\u7B49\u529F\u80FD\u3002\r\n\r\n3\u3001\u63D0\u4F9B\u5199\u5165\u5916\u90E8\u50A8\u5B58\u529F\u80FD\uFF0C\u7528\u4E8EApp\u5199\u5165/\u4E0B\u8F7D/\u4FDD\u5B58/\u4FEE\u6539/\u5220\u9664\u56FE\u7247\u3001\u6587\u4EF6\u3001\u5D29\u6E83\u65E5\u5FD7\u7B49\u4FE1\u606F\u3002\r\n\r\n4\u3001\u63D0\u4F9B\u8BFB\u53D6\u624B\u673A\u8BBE\u5907\u6807\u8BC6\u7B49\u4FE1\u606F\uFF0C\u8BF7\u60A8\u653E\u5FC3\u8BE5\u6743\u9650\u65E0\u6CD5\u76D1\u542C\u3001\u83B7\u53D6\u60A8\u7684\u4EFB\u4F55\u901A\u8BDD\u5185\u5BB9\u4E0E\u4FE1\u606F\uFF0C\u7528\u4E8E\u8BFB\u53D6\u8BBE\u5907\u901A\u8BDD\u72B6\u6001\u548C\u8BC6\u522B\u7801\uFF0C\u8BC6\u522B\u624B\u673A\u8BBE\u5907ID\uFF0C\u4FDD\u8BC1\u8FD0\u8425\u5546\u7F51\u7EDC\u514D\u6D41\u670D\u52A1\uFF0C\u7528\u4E8E\u5B8C\u6210\u97F3\u89C6\u9891\u3001\u4FE1\u606F\u5C55\u793A\u3001\u8D26\u53F7\u767B\u5F55\u3001\u5B89\u5168\u4FDD\u969C\u7B49\u4E3B\u8981\u529F\u80FD\r\n\r\n
      \r\n\r\n\u672C\u300A\u9690\u79C1\u653F\u7B56\u300B\u9002\u7528\u4E8E\u5409\u52A8\u76D8\u53E4\u5411\u60A8\u63D0\u4F9B\u7684\u4EA7\u54C1\u548C\u670D\u52A1\u3002\u5982\u60A8\u4F7F\u7528\u6211\u4EEC\u6216\u5173\u8054\u516C\u53F8\u5411\u60A8\u63D0\u4F9B\u7684\u67D0\u9879\u6216\u67D0\u51E0\u9879\u670D\u52A1\uFF0C\u6709\u5176\u5355\u72EC\u7684\u9690\u79C1\u653F\u7B56\u7684\uFF0C\u5219\u76F8\u5E94\u670D\u52A1\u6216\u4EA7\u54C1\u9002\u7528\u76F8\u5E94\u9690\u79C1\u653F\u7B56\uFF1B\u5982\u672A\u8BBE\u7ACB\u72EC\u7ACB\u9690\u79C1\u653F\u7B56\u7684\uFF0C\u5219\u672C\u653F\u7B56\u540C\u6837\u9002\u7528\u4E8E\u8BE5\u90E8\u5206\u4EA7\u54C1\u6216\u670D\u52A1\u3002\r\n\r\n\u4E0B\u6587\u5C06\u5E2E\u60A8\u8BE6\u7EC6\u4E86\u89E3\u6211\u4EEC\u5982\u4F55\u6536\u96C6\u3001\u4F7F\u7528\u3001\u5B58\u50A8\u3001\u8F6C\u79FB\uFF08\u5982\u9002\u7528\uFF09\u4E0E\u4FDD\u62A4\u4E2A\u4EBA\u4FE1\u606F\uFF1B\u5E2E\u60A8\u4E86\u89E3\u67E5\u9605\u3001\u590D\u5236\u3001\u66F4\u6B63\u3001\u5220\u9664\u3001\u64A4\u56DE\u6388\u6743\u4E2A\u4EBA\u4FE1\u606F\u7684\u65B9\u5F0F\u3002\u672C\u653F\u7B56\u4E0E\u60A8\u4F7F\u7528\u6211\u4EEC\u7684\u670D\u52A1\u5173\u7CFB\u5BC6\u5207\uFF0C\u6211\u4EEC\u5EFA\u8BAE\u60A8\u4ED4\u7EC6\u9605\u8BFB\u5E76\u7406\u89E3\u672C\u653F\u7B56\u5168\u90E8\u5185\u5BB9\uFF0C\u4F5C\u51FA\u60A8\u8BA4\u4E3A\u9002\u5F53\u7684\u9009\u62E9\uFF0C\u6709\u5173\u60A8\u4E2A\u4EBA\u4FE1\u606F\u6743\u76CA\u7684\u6761\u6B3E\u91CD\u8981\u5185\u5BB9\u6211\u4EEC\u5DF2\u7528\u52A0\u7C97\u5F62\u5F0F\u63D0\u793A\uFF0C\u8BF7\u7279\u522B\u5173\u6CE8\u3002\r\n\r\n\u672C\u300A\u9690\u79C1\u653F\u7B56\u300B\u65E8\u5728\u5E2E\u52A9\u60A8\u4E86\u89E3\u4EE5\u4E0B\u5185\u5BB9\uFF1A\r\n\r\n1.\u6211\u4EEC\u5982\u4F55\u6536\u96C6\u548C\u4F7F\u7528\u4E2A\u4EBA\u4FE1\u606F\r\n\r\n2.\u6211\u4EEC\u5982\u4F55\u4F7F\u7528cookie\u7B49\u540C\u7C7B\u6280\u672F\r\n\r\n3.\u6570\u636E\u4F7F\u7528\u8FC7\u7A0B\u4E2D\u6D89\u53CA\u7684\u5408\u4F5C\u65B9\u4EE5\u53CA\u8F6C\u79FB\u3001\u516C\u5F00\u4E2A\u4EBA\u4FE1\u606F\r\n\r\n4.\u6211\u4EEC\u5982\u4F55\u5B58\u50A8\u4E2A\u4EBA\u4FE1\u606F\r\n\r\n5.\u6211\u4EEC\u5982\u4F55\u4FDD\u62A4\u4E2A\u4EBA\u4FE1\u606F\u5B89\u5168\r\n\r\n6.\u6211\u4EEC\u5982\u4F55\u7BA1\u7406\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\r\n\r\n7.\u672A\u6210\u5E74\u4EBA\u6761\u6B3E\r\n\r\n8.\u9690\u79C1\u653F\u7B56\u7684\u4FEE\u8BA2\u548C\u901A\u77E5\r\n\r\n9.\u9002\u7528\u8303\u56F4\r\n\r\n10.\u5176\u4ED6\r\n\r\n1.\u6211\u4EEC\u5982\u4F55\u6536\u96C6\u548C\u4F7F\u7528\u4E2A\u4EBA\u4FE1\u606F\r\n\r\n\u6211\u4EEC\u4F1A\u6309\u7167\u5982\u4E0B\u65B9\u5F0F\u6536\u96C6\u60A8\u5728\u4F7F\u7528\u670D\u52A1\u65F6\u4E3B\u52A8\u63D0\u4F9B\u7684\uFF0C\u4EE5\u53CA\u901A\u8FC7\u81EA\u52A8\u5316\u624B\u6BB5\u6536\u96C6\u60A8\u5728\u4F7F\u7528\u529F\u80FD\u6216\u63A5\u53D7\u670D\u52A1\u8FC7\u7A0B\u4E2D\u4EA7\u751F\u7684\u4FE1\u606F\uFF1A\r\n\r\n1.1\u6CE8\u518C\u3001\u767B\u5F55\u3001\u8BA4\u8BC1\u3001\u627E\u56DE\r\n\r\n\u6211\u4EEC\u91C7\u7528\u5C0F\u7C73\u5E73\u53F0\u7B2C\u4E09\u65B9\u63A5\u5165SDK\uFF0C\u5B8C\u6210\u7528\u6237\u7684\u6CE8\u518C\uFF0C\u767B\u5F55\uFF0C\u8BA4\u8BC1\uFF0C\u627E\u56DE\u7B49\u529F\u80FD\u3002\r\n\r\n\u672C\u4E1A\u52A1\u4E2D\u90E8\u5206\u670D\u52A1\u5185\u5BB9\u7531\u7B2C\u4E09\u65B9\u670D\u52A1\u63D0\u4F9B\u5546\u63D0\u4F9B\uFF0C\u4E3A\u6B64\u6211\u4EEC\u9700\u8981\u5411\u7B2C\u4E09\u65B9\u670D\u52A1\u63D0\u4F9B\u5546\u63D0\u4F9B\u60A8\u53CA\u60A8\u7EC8\u7AEF\u7528\u6237\u7684\u7684\u90E8\u5206\u4E2A\u4EBA\u4FE1\u606F\uFF0C\u4E0B\u5217\u4E3A\u6211\u4EEC\u5411\u5173\u8054\u65B9\u3001\u5408\u4F5C\u4F19\u4F34\u53CA\u7B2C\u4E09\u65B9\u5171\u4EAB\u60A8\u53CA\u60A8\u7EC8\u7AEF\u7528\u6237\u7684\u7684\u4E2A\u4EBA\u4FE1\u606F\u7684\u60C5\u5F62\u3002\u5982\u6211\u4EEC\u4E0E\u8FD9\u4E9B\u7B2C\u4E09\u65B9\u5206\u4EAB\u60A8\u53CA\u60A8\u7EC8\u7AEF\u7528\u6237\u7684\u4E2A\u4EBA\u4FE1\u606F\uFF0C\u6211\u4EEC\u5C06\u91C7\u53D6\u52A0\u5BC6\u7B49\u624B\u6BB5\u4FDD\u969C\u60A8\u53CA\u60A8\u7EC8\u7AEF\u7528\u6237\u7684\u4FE1\u606F\u5B89\u5168\u3002\u5BF9\u6211\u4EEC\u4E0E\u4E4B\u5171\u4EAB\u4E2A\u4EBA\u4FE1\u606F\u7684\u516C\u53F8\u3001\u7EC4\u7EC7\uFF0C\u6211\u4EEC\u4F1A\u5BF9\u5176\u6570\u636E\u5B89\u5168\u73AF\u5883\u8FDB\u884C\u5408\u7406\u5BA1\u67E5\uFF0C\u5E76\u4E0E\u5176\u7B7E\u7F72\u4E25\u683C\u7684\u6570\u636E\u5904\u7406\u534F\u8BAE\uFF0C\u8981\u6C42\u7B2C\u4E09\u65B9\u5BF9\u60A8\u53CA\u60A8\u7EC8\u7AEF\u7528\u6237\u7684\u4FE1\u606F\u91C7\u53D6\u8DB3\u591F\u7684\u4FDD\u62A4\u63AA\u65BD\uFF0C\u4E25\u683C\u9075\u5B88\u76F8\u5173\u6CD5\u5F8B\u6CD5\u89C4\u4E0E\u76D1\u7BA1\u8981\u6C42\u3002\r\n\r\n\u6377\u4ED8\u777F\u901A\u80A1\u4EFD\u6709\u9650\u516C\u53F8\r\n\r\n\u5171\u4EAB\u65B9\u5F0F\uFF1A
      API\uFF08\u5B9E\u540D\u8BA4\u8BC1\u63A5\u53E3\uFF09(\u4EC5\u7F51\u6E38SDK\u63A5\u5165\uFF09\r\n\r\n\u5171\u4EAB\u76EE\u7684\uFF1A
      \u6309\u7167\u56FD\u5BB6\u89C4\u5B9A\u6E38\u620F\u73A9\u5BB6\u9700\u8981\u8FDB\u884C\u5B9E\u540D\u8BA4\u8BC1\r\n\r\n\u5171\u4EAB\u6570\u636E\u7C7B\u578B\uFF1A
      \u59D3\u540D\u3001\u8EAB\u4EFD\u8BC1\u53F7\u3001\u8EAB\u4EFD\u8BC1\u7167\u7247\u6216\u624B\u673A\u53F7\uFF08\u5F53\u7528\u6237\u9009\u62E9\u8BE5\u79CD\u8EAB\u4EFD\u8BC1\u7167\u7247\u6216\u624B\u673A\u53F7\u8FDB\u884C\u5B9E\u540D\u8BA4\u8BC1\uFF09\r\n\r\n\u9690\u79C1\u653F\u7B56\u94FE\u63A5\uFF1A
      https://privacy.mi.com/all/zh_CN/\r\n\r\n\u7F51\u7EDC\u6E38\u620F\u9632\u6C89\u8FF7\u5B9E\u540D\u8BA4\u8BC1\u7CFB\u7EDF\r\n\r\n\u5171\u4EAB\u65B9\u5F0F\uFF1A
      API (\u4EC5\u7F51\u6E38SDK\u63A5\u5165\uFF09\r\n\r\n\u5171\u4EAB\u76EE\u7684\uFF1A
      \u6309\u7167\u56FD\u5BB6\u89C4\u5B9A\u6E38\u620F\u73A9\u5BB6\u9700\u8981\u8FDB\u884C\u5B9E\u540D\u8BA4\u8BC1\u4E14\u9700\u8981\u4E0A\u62A5\u7528\u6237\u6E38\u620F\u6570\u636E\r\n\r\n\u5171\u4EAB\u6570\u636E\u7C7B\u578B\uFF1A
      \u59D3\u540D\u3001\u8EAB\u4EFD\u8BC1\u3001\u7528\u6237\u6E38\u620F\u4E0A\u4E0B\u7EBF\u65F6\u95F4\u3001\u7528\u6237\u8EAB\u4EFD\u6807\u8BC6\u3001\u6240\u73A9\u7684\u6E38\u620F\u6807\u8BC6\r\n\r\n\u9690\u79C1\u653F\u7B56\u94FE\u63A5\uFF1A
      https://wlc.nppa.gov.cn/fcm_company/index.html#/login?redirect=%2F\r\n\r\n
      \r\n\r\n1.2 \u4FDD\u969C\u6E38\u620F\u670D\u52A1\u7684\u6B63\u5E38\u8FD0\u884C\r\n\r\na.\u5728\u60A8\u4F7F\u7528\u6E38\u620F\u670D\u52A1\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u4F1A\u5728\u6E38\u620F\u4E2D\u751F\u6210\u4E00\u4E9B\u4E0E\u60A8\u6709\u5173\u7684\u4FE1\u606F\uFF0C\u4F8B\u5982\uFF1A\u6E38\u620F\u89D2\u8272\u4FE1\u606F\u3001\u6E38\u620F\u5185\u804A\u5929\u8BB0\u5F55\u3001\u6E38\u620F\u65E5\u5FD7\u3001\u5206\u4EAB\u8BB0\u5F55\u7B49\u3002\u7CFB\u7EDF\u5C06\u5728\u60A8\u7684\u8D26\u53F7\u9879\u4E0B\u8BB0\u5F55\u8FD9\u4E9B\u4FE1\u606F\uFF0C\u4EE5\u4FBF\u60A8\u80FD\u591F\u5728\u5BA2\u6237\u7AEF\u67E5\u770B\u60A8\u7684\u6E38\u620F\u5386\u53F2\u8BB0\u5F55\u3002\u6211\u4EEC\u8FD8\u53EF\u80FD\u4F1A\u5C06\u60A8\u7684\u6E38\u620F\u89D2\u8272\u4FE1\u606F\u3001\u6E38\u620F\u65E5\u5FD7\u4FE1\u606F\u7528\u4E8E\u6E38\u620F\u8FD0\u8425\u7EDF\u8BA1\u5206\u6790\u3001\u5BA2\u670D\u6295\u8BC9\u5904\u7406\u53CA\u5176\u4ED6\u6E38\u620F\u5B89\u5168\u5206\u6790\uFF1B\u4E3A\u63D0\u5347\u60A8\u7684\u6E38\u620F\u4F53\u9A8C\uFF0C\u6211\u4EEC\u53EF\u80FD\u628A\u524D\u8FF0\u4FE1\u606F\u540C\u6B65\u81F3\u8BE5\u6E38\u620F\u540E\u7EED\u7248\u672C\u6216\u60A8\u6B63\u5728\u4F7F\u7528\u7684\u6211\u4EEC\u63D0\u4F9B\u7684\u5176\u4ED6\u4EA7\u54C1\u6216\u670D\u52A1\u4E2D\u3002\r\n\r\n1.3
      \u8FD0\u8425\u4E0E\u5B89\u5168\u8FD0\u884C/\u4FDD\u969C\r\n\r\n\uFF081\uFF09\u8FD0\u8425\u4E0E\u5B89\u5168\u4FDD\u969C\r\n\r\n\u6211\u4EEC\u81F4\u529B\u4E8E\u4E3A\u60A8\u63D0\u4F9B\u5B89\u5168\u3001\u53EF\u4FE1\u7684\u4EA7\u54C1\u4E0E\u4F7F\u7528\u73AF\u5883\uFF0C\u63D0\u4F9B\u4F18\u8D28\u800C\u53EF\u9760\u7684\u670D\u52A1\u4E0E\u4FE1\u606F\u662F\u6211\u4EEC\u7684\u6838\u5FC3\u76EE\u6807\u3002\u4E3A\u4E86\u7EF4\u62A4\u6211\u4EEC\u670D\u52A1\u7684\u6B63\u5E38\u8FD0\u884C\uFF0C\u4FDD\u62A4\u60A8\u6216\u5176\u4ED6\u7528\u6237\u6216\u516C\u4F17\u7684\u5408\u6CD5\u5229\u76CA\u514D\u53D7\u635F\u5931\uFF0C\u6211\u4EEC\u4F1A\u6536\u96C6\u7528\u4E8E\u7EF4\u62A4\u4EA7\u54C1\u6216\u670D\u52A1\u5B89\u5168\u7A33\u5B9A\u8FD0\u884C\u7684\u5FC5\u8981\u4FE1\u606F\u3002\r\n\r\n\uFF082\uFF09\u8BBE\u5907\u4FE1\u606F\u4E0E\u65E5\u5FD7\u4FE1\u606F\r\n\r\na.\u4E3A\u4E86\u4FDD\u969C\u8F6F\u4EF6\u4E0E\u670D\u52A1\u7684\u5B89\u5168\u8FD0\u884C\u3001\u8FD0\u8425\u7684\u8D28\u91CF\u53CA\u6548\u7387\uFF0C\u6211\u4EEC\u4F1A\u6536\u96C6\u60A8\u7684\u786C\u4EF6\u578B\u53F7\u3001\u64CD\u4F5C\u7CFB\u7EDF\u7248\u672C\u53F7\u3001\u8BBE\u5907\u6807\u8BC6\u7B26\uFF08Android\u5982IMEI\u3001AndroidID\u3001OAID\u3001IMSI\u3001ICCID\u3001MEID\u3001\u786C\u4EF6\u5E8F\u5217\u53F7\uFF0CiOS\u5982IDFV\u3001IDFA\uFF1B\u4E0D\u540C\u7684\u6807\u8BC6\u7B26\u5728\u6709\u6548\u671F\u3001\u662F\u5426\u53EF\u7531\u7528\u6237\u91CD\u7F6E\u4EE5\u53CA\u83B7\u53D6\u65B9\u5F0F\u65B9\u9762\u4F1A\u6709\u6240\u4E0D\u540C\uFF09\u3001\u7F51\u7EDC\u8BBE\u5907\u786C\u4EF6\u5730\u5740\uFF08MAC\u5730\u5740\uFF09\u3001IP
      \u5730\u5740\u3001WLAN\u63A5\u5165\u70B9\uFF08\u5982SSID\uFF0CBSSID\uFF09\u3001\u84DD\u7259\uFF08Bluetooth\uFF09\u3001\u57FA\u7AD9\u3001\u8F6F\u4EF6\u7248\u672C\u53F7\u3001\u7F51\u7EDC\u63A5\u5165\u65B9\u5F0F\u3001\u7C7B\u578B\u3001\u72B6\u6001\u3001\u7F51\u7EDC\u8D28\u91CF\u6570\u636E\u3001\u64CD\u4F5C\u3001\u4F7F\u7528\u3001\u670D\u52A1\u65E5\u5FD7\u3001\u8BBE\u5907\u4F20\u611F\u5668\u6570\u636E\u3002\u4E3A\u4E86\u4FDD\u8BC1\u6E38\u620F\u4E1A\u52A1\u8FDE\u7EED\u6027\u4EE5\u53CA\u5B89\u5168\u9632\u62A4\u53CD\u5916\u6302\u7B49\u76EE\u7684\uFF0C\u5F53\u60A8\u6253\u5F00\u6E38\u620F\u5E76\u6700\u5C0F\u5316\u8FD0\u884C\uFF08\u540E\u53F0\u72B6\u6001\uFF09\u65F6\uFF0C\u91C7\u96C6\u4ECD\u4F1A\u6301\u7EED\u4E00\u5C0F\u6BB5\u65F6\u95F4\uFF0C\u4EE5\u4FBF\u60A8\u5728\u6700\u5927\u5316\u8FD0\u884C\u5E94\u7528\u7A0B\u5E8F\u65F6\u7EE7\u7EED\u5411\u60A8\u63D0\u4F9B\u8FDE\u8D2F\u7684\u670D\u52A1\u3002\r\n\r\nb.\u4E3A\u4E86\u9884\u9632\u6076\u610F\u7A0B\u5E8F\u3001\u4FDD\u969C\u8FD0\u8425\u8D28\u91CF\u53CA\u6548\u7387\uFF0C\u6211\u4EEC\u4F1A\u6536\u96C6\u5B89\u88C5\u7684\u5E94\u7528\u4FE1\u606F\u6216\u6B63\u5728\u8FD0\u884C\u7684\u8FDB\u7A0B\u4FE1\u606F\u3001\u5E94\u7528\u7A0B\u5E8F\u7684\u603B\u4F53\u8FD0\u884C\u3001\u4F7F\u7528\u60C5\u51B5\u4E0E\u9891\u7387\u3001\u5E94\u7528\u5D29\u6E83\u60C5\u51B5\u3001\u603B\u4F53\u5B89\u88C5\u4F7F\u7528\u60C5\u51B5\u3001\u6027\u80FD\u6570\u636E\u3001\u5E94\u7528\u6765\u6E90\u3002\r\n\r\nc.\u4E3A\u4E86\u5206\u6790\u5E94\u7528\u65B0\u589E\u3001\u6FC0\u6D3B\u3001\u7559\u5B58\u3001\u6027\u80FD\u7B49\u7EDF\u8BA1\u6027\u6307\u6807\uFF0C\u6211\u4EEC\u53EF\u80FD\u4F1A\u8C03\u7528\u526A\u5207\u677F\u5BF9\u76F8\u5173\u7EDF\u8BA1\u4FE1\u606F\u8FDB\u884C\u5F52\u56E0\u5206\u6790\uFF0C\u8BF7\u60A8\u653E\u5FC3\uFF0C\u6211\u4EEC\u4E0D\u4F1A\u6536\u96C6\u60A8\u7684\u9690\u79C1\u4FE1\u606F\u3002\r\n\r\nd.\u6211\u4EEC\u53EF\u80FD\u4F7F\u7528\u60A8\u7684\u8D26\u6237\u4FE1\u606F\u3001\u8BBE\u5907\u4FE1\u606F\u3001\u670D\u52A1\u65E5\u5FD7\u4FE1\u606F\u4EE5\u53CA\u6211\u4EEC\u5173\u8054\u65B9\u3001\u5408\u4F5C\u65B9\u5728\u83B7\u5F97\u60A8\u6388\u6743\u6216\u4F9D\u6CD5\u53EF\u4EE5\u63D0\u4F9B\u7684\u4FE1\u606F\uFF0C\u7528\u4E8E\u5224\u65AD\u8D26\u6237\u53CA\u4EA4\u6613\u5B89\u5168\u3001\u8FDB\u884C\u8EAB\u4EFD\u9A8C\u8BC1\u3001\u8BC6\u522B\u8FDD\u6CD5\u8FDD\u89C4\u60C5\u51B5\u3001\u68C0\u6D4B\u53CA\u9632\u8303\u5B89\u5168\u4E8B\u4EF6\uFF0C\u5E76\u4F9D\u6CD5\u91C7\u53D6\u5FC5\u8981\u7684\u8BB0\u5F55\u3001\u5206\u6790\u3001\u5904\u7F6E\u63AA\u65BD\u3002\r\n\r\n1.5
      \u5F81\u5F97\u6388\u6743\u540C\u610F\u7684\u4F8B\u5916\r\n\r\n\u8BF7\u60A8\u7406\u89E3\uFF0C\u5728\u4E0B\u5217\u60C5\u5F62\u4E2D\uFF0C\u6839\u636E\u6CD5\u5F8B\u6CD5\u89C4\u53CA\u76F8\u5173\u56FD\u5BB6\u6807\u51C6\uFF0C\u6211\u4EEC\u6536\u96C6\u548C\u4F7F\u7528\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\u4E0D\u5FC5\u4E8B\u5148\u5F81\u5F97\u60A8\u7684\u6388\u6743\u540C\u610F\uFF1A\r\n\r\na.\u4E0E\u6211\u4EEC\u5C65\u884C\u6CD5\u5F8B\u6CD5\u89C4\u89C4\u5B9A\u7684\u4E49\u52A1\u76F8\u5173\u7684\uFF1B\r\n\r\nb.\u4E0E\u56FD\u5BB6\u5B89\u5168\u3001\u56FD\u9632\u5B89\u5168\u76F4\u63A5\u76F8\u5173\u7684\uFF1B\r\n\r\nc.\u4E0E\u516C\u5171\u5B89\u5168\u3001\u516C\u5171\u536B\u751F\u3001\u91CD\u5927\u516C\u5171\u5229\u76CA\u76F4\u63A5\u76F8\u5173\u7684\uFF1B\r\n\r\nd.\u4E0E\u5211\u4E8B\u4FA6\u67E5\u3001\u8D77\u8BC9\u3001\u5BA1\u5224\u548C\u5224\u51B3\u6267\u884C\u7B49\u76F4\u63A5\u76F8\u5173\u7684\uFF1B\r\n\r\ne.\u51FA\u4E8E\u7EF4\u62A4\u60A8\u6216\u4ED6\u4EBA\u7684\u751F\u547D\u3001\u8D22\u4EA7\u7B49\u91CD\u5927\u5408\u6CD5\u6743\u76CA\u4F46\u53C8\u5F88\u96BE\u5F97\u5230\u672C\u4EBA\u6388\u6743\u540C\u610F\u7684\uFF1B\r\n\r\nf.\u60A8\u81EA\u884C\u5411\u793E\u4F1A\u516C\u4F17\u516C\u5F00\u7684\u4E2A\u4EBA\u4FE1\u606F\uFF1B\r\n\r\ng.\u6839\u636E\u4E2A\u4EBA\u4FE1\u606F\u4E3B\u4F53\u8981\u6C42\u7B7E\u8BA2\u548C\u5C65\u884C\u5408\u540C\u6240\u5FC5\u9700\u7684\uFF1B\r\n\r\nh.\u4ECE\u5408\u6CD5\u516C\u5F00\u62AB\u9732\u7684\u4FE1\u606F\u4E2D\u6536\u96C6\u7684\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\u7684\uFF0C\u5982\u5408\u6CD5\u7684\u65B0\u95FB\u62A5\u9053\u3001\u653F\u5E9C\u4FE1\u606F\u516C\u5F00\u7B49\u6E20\u9053\uFF1B\r\n\r\ni.\u7528\u4E8E\u7EF4\u62A4\u8F6F\u4EF6\u53CA\u76F8\u5173\u670D\u52A1\u7684\u5B89\u5168\u7A33\u5B9A\u8FD0\u884C\u6240\u5FC5\u9700\u7684\uFF0C\u4F8B\u5982\u53D1\u73B0\u3001\u5904\u7F6E\u8F6F\u4EF6\u53CA\u76F8\u5173\u670D\u52A1\u7684\u6545\u969C\uFF1B\r\n\r\nj.\u4E3A\u5F00\u5C55\u5408\u6CD5\u7684\u65B0\u95FB\u62A5\u9053\u6240\u5FC5\u9700\u7684\uFF1B\r\n\r\nk.\u4E3A\u5B66\u672F\u7814\u7A76\u673A\u6784\uFF0C\u57FA\u4E8E\u516C\u5171\u5229\u76CA\u5F00\u5C55\u7EDF\u8BA1\u6216\u5B66\u672F\u7814\u7A76\u6240\u5FC5\u8981\uFF0C\u4E14\u5BF9\u5916\u63D0\u4F9B\u5B66\u672F\u7814\u7A76\u6216\u63CF\u8FF0\u7684\u7ED3\u679C\u65F6\uFF0C\u5BF9\u7ED3\u679C\u4E2D\u6240\u5305\u542B\u7684\u4E2A\u4EBA\u4FE1\u606F\u8FDB\u884C\u53BB\u6807\u8BC6\u5316\u5904\u7406\u7684\uFF1B\r\n\r\nl.\u6CD5\u5F8B\u6CD5\u89C4\u89C4\u5B9A\u7684\u5176\u4ED6\u60C5\u5F62\u3002\r\n\r\n\u7279\u522B\u63D0\u793A\u60A8\u6CE8\u610F\uFF0C\u5982\u4FE1\u606F\u65E0\u6CD5\u5355\u72EC\u6216\u7ED3\u5408\u5176\u4ED6\u4FE1\u606F\u8BC6\u522B\u5230\u60A8\u7684\u4E2A\u4EBA\u8EAB\u4EFD\uFF0C\u5176\u4E0D\u5C5E\u4E8E\u6CD5\u5F8B\u610F\u4E49\u4E0A\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\uFF1B\u5F53\u60A8\u7684\u4FE1\u606F\u53EF\u4EE5\u5355\u72EC\u6216\u7ED3\u5408\u5176\u4ED6\u4FE1\u606F\u8BC6\u522B\u5230\u60A8\u7684\u4E2A\u4EBA\u8EAB\u4EFD\u65F6\u6216\u6211\u4EEC\u5C06\u65E0\u6CD5\u4E0E\u4EFB\u4F55\u7279\u5B9A\u4E2A\u4EBA\u4FE1\u606F\u5EFA\u7ACB\u8054\u7CFB\u7684\u6570\u636E\u4E0E\u5176\u4ED6\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\u7ED3\u5408\u4F7F\u7528\u65F6\uFF0C\u8FD9\u4E9B\u4FE1\u606F\u5728\u7ED3\u5408\u4F7F\u7528\u671F\u95F4\uFF0C\u5C06\u4F5C\u4E3A\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\u6309\u7167\u672C\u300A\u9690\u79C1\u653F\u7B56\u300B\u5904\u7406\u4E0E\u4FDD\u62A4\u3002\r\n\r\n2.
      \u6211\u4EEC\u5982\u4F55\u4F7F\u7528cookie\u7B49\u540C\u7C7B\u6280\u672F\r\n\r\nCookie\u548C\u540C\u7C7B\u6280\u672F\u662F\u4E92\u8054\u7F51\u4E2D\u7684\u901A\u7528\u5E38\u7528\u6280\u672F\u3002\u5F53\u60A8\u4F7F\u7528\u6E38\u620F\u670D\u52A1\u65F6\uFF0C\u6211\u4EEC\u53EF\u80FD\u4F1A\u4F7F\u7528\u76F8\u5173\u6280\u672F\u5411\u60A8\u7684\u8BBE\u5907\u53D1\u9001\u4E00\u4E2A\u6216\u591A\u4E2ACookie\u6216\u533F\u540D\u6807\u8BC6\u7B26\uFF0C\u4EE5\u6536\u96C6\u548C\u5B58\u50A8\u60A8\u8BBF\u95EE\u3001\u4F7F\u7528\u672C\u4EA7\u54C1\u65F6\u7684\u4FE1\u606F\u3002\u6211\u4EEC\u4F7F\u7528Cookie\u548C\u540C\u7C7B\u6280\u672F\u4E3B\u8981\u4E3A\u4E86\u5B9E\u73B0\u4EE5\u4E0B\u529F\u80FD\u6216\u670D\u52A1\uFF1A\r\n\r\n2.1
      \u4FDD\u969C\u4EA7\u54C1\u4E0E\u670D\u52A1\u7684\u5B89\u5168\u3001\u9AD8\u6548\u8FD0\u8F6C\r\n\r\n\u6211\u4EEC\u53EF\u80FD\u4F1A\u8BBE\u7F6E\u8BA4\u8BC1\u4E0E\u4FDD\u969C\u5B89\u5168\u6027\u7684Cookie\u6216\u533F\u540D\u6807\u8BC6\u7B26\uFF0C\u4F7F\u6211\u4EEC\u786E\u8BA4\u60A8\u662F\u5426\u5B89\u5168\u767B\u5F55\u670D\u52A1\uFF0C\u6216\u8005\u662F\u5426\u9047\u5230\u76D7\u7528\u3001\u6B3A\u8BC8\u7B49\u4E0D\u6CD5\u884C\u4E3A\u3002\u8FD9\u4E9B\u6280\u672F\u8FD8\u4F1A\u5E2E\u52A9\u6211\u4EEC\u6539\u8FDB\u670D\u52A1\u6548\u7387\uFF0C\u63D0\u5347\u767B\u5F55\u548C\u54CD\u5E94\u901F\u5EA6\u3002\r\n\r\n2.2
      \u5E2E\u52A9\u60A8\u83B7\u5F97\u66F4\u8F7B\u677E\u7684\u8BBF\u95EE\u4F53\u9A8C\r\n\r\n\u4F7F\u7528\u6B64\u7C7B\u6280\u672F\u53EF\u4EE5\u5E2E\u52A9\u60A8\u7701\u53BB\u91CD\u590D\u60A8\u586B\u5199\u4E2A\u4EBA\u4FE1\u606F\u3001\u8F93\u5165\u641C\u7D22\u5185\u5BB9\u7684\u6B65\u9AA4\u548C\u6D41\u7A0B\uFF08\u4F8B\u5982\uFF1A\u5B9E\u73B0\u4E00\u952E\u767B\u5F55\u6D41\u7A0B\u3001\u8BB0\u5F55\u641C\u7D22\u5386\u53F2\uFF09\u3002\r\n\r\n3.
      \u6570\u636E\u4F7F\u7528\u8FC7\u7A0B\u4E2D\u6D89\u53CA\u7684\u5408\u4F5C\u65B9\u4EE5\u53CA\u8F6C\u79FB\u3001\u516C\u5F00\u4E2A\u4EBA\u4FE1\u606F\r\n\r\n3.1
      \u6570\u636E\u4F7F\u7528\u8FC7\u7A0B\u4E2D\u6D89\u53CA\u7684\u5408\u4F5C\u65B9\r\n\r\n3.1.1
      \u539F\u5219\r\n\r\na.\u5408\u6CD5\u539F\u5219\uFF1A\u4E0E\u5408\u4F5C\u65B9\u5408\u4F5C\u8FC7\u7A0B\u4E2D\u6D89\u53CA\u6570\u636E\u4F7F\u7528\u6D3B\u52A8\u7684\uFF0C\u5FC5\u987B\u5177\u6709\u5408\u6CD5\u76EE\u7684\u3001\u7B26\u5408\u6CD5\u5B9A\u7684\u5408\u6CD5\u6027\u57FA\u7840\u3002\u5982\u679C\u5408\u4F5C\u65B9\u4F7F\u7528\u4FE1\u606F\u4E0D\u518D\u7B26\u5408\u5408\u6CD5\u539F\u5219\uFF0C\u5219\u5176\u4E0D\u5E94\u518D\u4F7F\u7528\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\uFF0C\u6216\u5728\u83B7\u5F97\u76F8\u5E94\u5408\u6CD5\u6027\u57FA\u7840\u540E\u518D\u884C\u4F7F\u7528\u3002\r\n\r\nb.\u6B63\u5F53\u4E0E\u6700\u5C0F\u5FC5\u8981\u539F\u5219\uFF1A\u6570\u636E\u4F7F\u7528\u5FC5\u987B\u5177\u6709\u6B63\u5F53\u76EE\u7684\uFF0C\u4E14\u5E94\u4EE5\u8FBE\u6210\u76EE\u7684\u5FC5\u8981\u4E3A\u9650\u3002\r\n\r\nc.\u5B89\u5168\u5BA1\u614E\u539F\u5219\uFF1A
      \u6211\u4EEC\u5C06\u5BA1\u614E\u8BC4\u4F30\u5408\u4F5C\u65B9\u4F7F\u7528\u6570\u636E\u7684\u76EE\u7684\uFF0C\u5BF9\u8FD9\u4E9B\u5408\u4F5C\u65B9\u7684\u5B89\u5168\u4FDD\u969C\u80FD\u529B\u8FDB\u884C\u7EFC\u5408\u8BC4\u4F30\uFF0C\u5E76\u8981\u6C42\u5176\u9075\u5FAA\u5408\u4F5C\u6CD5\u5F8B\u534F\u8BAE\u3002\u6211\u4EEC\u4F1A\u5BF9\u5408\u4F5C\u65B9\u83B7\u53D6\u4FE1\u606F\u7684\u8F6F\u4EF6\u5DE5\u5177\u5F00\u53D1\u5305\uFF08SDK\uFF09\u3001\u5E94\u7528\u7A0B\u5E8F\u63A5\u53E3\uFF08API\uFF09\u8FDB\u884C\u4E25\u683C\u7684\u5B89\u5168\u76D1\u6D4B\uFF0C\u4EE5\u4FDD\u62A4\u6570\u636E\u5B89\u5168\u3002\r\n\r\n\u63A5\u5165\u5408\u4F5C\u65B9SDK\u76EE\u5F55\r\n\r\n1\u3001\u5C0F\u7C73\u6E38\u620F\u8054\u8FD0SDK\uFF08\u5317\u4EAC\u74E6\u529B\u7F51\u7EDC\u79D1\u6280\u6709\u9650\u516C\u53F8\uFF09\r\n\r\n\u6D89\u53CA\u4E2A\u4EBA\u4FE1\u606F\uFF1A\u8BBE\u5907\u6807\u8BC6\u3010OAID\u3001\u52A0\u5BC6\u7684Android
      ID\u3001IMEI\u53F7(\u9488\u5BF9\u5B89\u5353\u53CA\u4E4B\u524D)\u3011\u3001\u8BBE\u5907\u4FE1\u606F(\u8BBE\u5907\u5382\u5546\u3001\u578B\u53F7\u3001\u5F52\u5C5E\u5730\u3001\u8FD0\u8425\u5546\u540D\u79F0\u7B49)\u3001\u8F6F\u4EF6\u76F8\u5173\u4FE1\u606F(Android\u7CFB\u7EDF\u548CSDK\u7248\u672C\u53F7\u3001Android
      ID\u3001\u6E38\u620F\u670D\u52A1\u7248\u672C\u53F7\u3001wifi \u7684 SSID/BSSID\u3001MIUI\u7248\u672C\u53F7\u7B49)\u3001\u4E2A\u4EBA\u4FE1\u606F\u3010\u59D3\u540D\u548C\u8EAB\u4EFD\u8BC1\u53F7\u7801(\u7528\u4E8E\u5B9E\u540D\u5236\u3001\u9632\u6C89\u8FF7\u529F\u80FD)\u3001\u7B2C\u4E09\u65B9\u8D26\u53F7\u4FE1\u606F\uFF08\u7528\u4E8E\u5B9E\u73B0\u767B\u5F55\u8D26\u53F7\uFF09\u3001\u6E38\u620F\u7684ID\u3001\u6E38\u620F\u5305\u540D\u3001\u6E38\u620F\u7248\u672C\u53F7\u3001\u6E38\u620F\u5546\u54C1\u540D\u79F0\u3001\u5546\u54C1\u91D1\u989D\u548C\u5B89\u88C5\u6765\u6E90\uFF08\u7528\u4E8E\u5B9E\u73B0\u652F\u4ED8\u529F\u80FD\uFF09\u3011\r\n\r\n\u4F7F\u7528\u76EE\u7684\uFF1A\u63D0\u4F9B\u6E38\u620F\u8D26\u53F7\u767B\u5F55\u3001\u652F\u4ED8\u3001\u5B9E\u540D\u5236\u4E0E\u9632\u6C89\u8FF7\u7BA1\u7406\r\n\r\n\u4F7F\u7528\u573A\u666F\uFF1A\u8BBF\u95EE\u7F51\u7EDC\u72B6\u6001\u3001\u83B7\u53D6\u8BBE\u5907\u4FE1\u606F\u3001\u5199\u5165\u8BBE\u5907\u5B58\u50A8\u3001\u83B7\u53D6\u8EAB\u4F53\u4F20\u611F\u5668\u4FE1\u606F\u3001\u8BFB\u53D6\u5E94\u7528\u5217\u8868\u3001\u76F8\u673A\r\n\r\n\u6536\u96C6\u65B9\u5F0F\uFF1ASDK\u91C7\u96C6\r\n\r\n\u5408\u4F5C\u65B9\u94FE\u63A5\uFF1A\r\n\r\n\u5B98\u7F51\u94FE\u63A5\uFF1A
      https://dev.mi.com/distribute/doc/details?pId=1376\r\n\r\n\u9690\u79C1\u653F\u7B56\uFF1Ahttps://dev.mi.com/distribute/doc/details?pId=1402\r\n\r\n2\u3001Talkingdate\u5E94\u7528\u7EDF\u8BA1\u3001\u6E38\u620F\u8FD0\u8425\u5206\u6790\u3001\u79FB\u52A8\u5E7F\u544A\u68C0\u6D4BSDK\uFF08\u5317\u4EAC\u817E\u4E91\u5929\u4E0B\u79D1\u6280\u6709\u9650\u516C\u53F8\uFF09\r\n\r\n\u6D89\u53CA\u4E2A\u4EBA\u4FE1\u606F\uFF1A\u8BBE\u5907\u4FE1\u606F\u3010Android\u3011\u8BBE\u5907\u54C1\u724C\u3001IMEI\u4FE1\u606F\u3001MAC\u578B\u53F7\u3001\u8F6F\u4EF6\u7248\u672C\u4EE5\u53CA\u83B7\u53D6\u7CFB\u7EDF\u5B89\u88C5\u5E94\u7528\u7A0B\u5E8F\u7B49\u57FA\u7840\u4FE1\u606F\u53CA\u5176\u5E94\u7528\u5217\u8868\u4FE1\u606F\u3002\u7F51\u7EDC\u4FE1\u606F\uFF1A\u8BBE\u5907\u94FE\u63A5WIFI\u548C\u6324\u5360\u4FE1\u606F\u3002\u4F4D\u7F6E\u4FE1\u606F\uFF1A\u8BBE\u5907\u5730\u7406\u4F4D\u7F6E\u3002\u5E94\u7528\u4FE1\u606F\uFF1ASDK\u5BBF\u4E3B\u5E94\u7528\u5305\u540D\u3001\u7248\u672C\u53F7\u7B49\u4FE1\u606F\u3002\r\n\r\n\u4F7F\u7528\u76EE\u7684\uFF1A\u5E94\u7528\u7EDF\u8BA1\u5206\u6790\uFF1B\u4F5C\u5F0A\u9632\u62A4\uFF1B\u63A8\u9001\u8425\u9500\uFF1B\u6E38\u620F\u8FD0\u8425\u5206\u6790\uFF1B\u79FB\u52A8\u5E7F\u544A\u76D1\u6D4B\r\n\r\n\u4F7F\u7528\u573A\u666F\uFF1A\u5728\u7528\u6237\u4F7F\u7528App\u65F6\u4F7F\u7528\r\n\r\n\u6536\u96C6\u65B9\u5F0F\uFF1ASDK\u91C7\u96C6\r\n\r\n\u5408\u4F5C\u65B9\u94FE\u63A5\uFF1A\r\n\r\n\u5B98\u7F51\u94FE\u63A5\uFF1A
