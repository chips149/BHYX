    characterSequence: "\u5DDD\u6E1F\u5370\r\n\u6BCF3\u6B21\u653B\u51FB\u843D\u5370\r\n\u653B\u51FB\u529B+25%\u4FEE\u6539\u3001\u653B\u51FB\u95F4\u9694+25%\u4FEE\u6539\r\n\r\n\u6CA7\u6D77\u8861\r\n\u9AD8\u989D\u4F24\u5BB3\u52A0\u6210\r\n\u66B4\u51FB+50%\u4FEE\u6539\u3001\u66B4\u51FB\u4F24\u5BB3+50%\u4FEE\u6539\r\n\r\n\u78A7\u6CE2\u73CF\r\n\u6BCF\u6B21\u7A7A\u67AA\u4E0B\u4E00\u67AA\u4F24\u5BB3+1\r\n\u653B\u51FB\u95F4\u9694+50%\u4FEE\u6539\r\n\u57FA\u7840\u8840\u91CF\u4E0D\u56FA\u5B9A\r\n\u63D0\u524D3\u884C\u51B2\u51FB\u6805\u680F\r\n\u670960%\u95EA\u907F\uFF0C\u6BCF\u6B21\u95EA\u907F-20%\u95EA\u907F\u6982\u7387\u4E14\u5411\u540E\u53D1\u5C04\u4E00\u9897\u5C0F\u6C34\u6EF4\r\n\u653B\u51FB\u4F1A\u70B9\u71C3\u5267\u5236\u4F5C\u65B9\uFF1A\r\n\u5409\u6797\u52A8\u753B\u5B66\u9662\u6E38\u620F\u5B66\u9662-\u6E38\u620F\u5B75\u5316\u56E2\u961F\r\n\u53D1\u884C\u65B9\uFF1A\r\n\u5409\u6797\u5409\u52A8\u76D8\u53E4\u7F51\u7EDC\u79D1\u6280\u80A1\u4EFD\u6709\u9650\u516C\u53F8\r\n\u9879\u76EE\u603B\u8D1F\u8D23\u4EBA\uFF1A\u5B89\u5B81\r\n\u6267\u884C\u8D1F\u8D23\u4EBA\uFF1A\u674E\u5CA9\r\n=========\u9879\u76EE\u7EC4\u6210\u5458==========\r\n\u9879\u76EE\u6307\u5BFC\u6559\u5E08\uFF1A\u674E\u5CA9\u3001\u71D5\u9752\r\n\u7B56\u5212\u8D1F\u8D23\u4EBA\uFF1A\u738B\u4E49\u535A 
      \u7F8E\u672F\u8D1F\u8D23\u4EBA\uFF1A\u71D5\u9752\r\n\u7A0B\u5E8F\u8D1F\u8D23\u4EBA\uFF1A\u5F20\u99A8\u6708\r\n\u7B56\u5212\u7EC4\uFF1A\u738B\u4E49\u535A\u3001\u9AD8\u6218\u3001\u6BD5\u98DE\u6768\r\n\u7F8E\u672F\u7EC4\uFF1A\u5415\u6674\u3001\u5F20\u65ED\u4E1C\u3001\u9AD8\u57F9\u5C27\u3001\u4F55\u65B0\u5B87\r\n\u5510\u57F9\u96EF\u3001\u6C88\u5168\u8FB0\u3001\u9648\u6CEF\u6C5F\u3001\u53F6\u598D\u82B3\r\n\u5F20\u4EA6\u975E\u3001\u5F20\u8096\u6653\u3001\u8D56\u6210\u9F99\u3001\u71D5\u9752\r\n\u7A0B\u5E8F\u7EC4\uFF1A
      \u5F20\u99A8\u6708\u3001\u6BCD\u6653\u83F2\u3001\u674E\u5CA9\u3001\u90D1\u4F1F\u4E1C\r\n=======\u6E38\u620F\u5B75\u5316\u56E2\u961F\u6210\u5458========\r\n\u7B56\u5212\u56E2\u961F\uFF1A\u674E\u5CA9\u3001\u9AD8\u6218\u3001\u738B\u4E49\u535A\u3001\u6BD5\u98DE\u6768\r\n\u8D75\u946B\u3001\u738B\u4E49\u535A\u3001\u6B66\u6587\u6CF0\u3001\u674E\u5955\u7136\r\n\u4E8C\u7EF4\u7F8E\u672F\u56E2\u961F\uFF1A\u71D5\u9752\u3001\u535C\u51E1\u5A77\u3001\u5415\u6674\u3001\u949F\u9716\u602A\u7269\u56FE\u9274\u6587\u672C\r\n\r\n\u706B\u7075\r\n\u57FA\u7840\u8840\u91CF\u4E0D\u56FA\u5B9A\r\n\u5C71\u6D77\u4E16\u754C\u8BDE\u751F\u4E4B\u521D\u706B\u7130\u5143\u7D20\u5E7B\u5316\u7684\u706B\u7075\u3002\r\n\r\n\u51E4\u51F0\r\n\u63D0\u524D3\u884C\u51B2\u51FB\u6805\u680F\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u4E39\u7A74\u5C71\u6709\u795E\u9E1F\u540D\u51E4\u51F0\uFF0C\u96C6\u65E5\u6708\u4E4B\u534E\u3001\u6C90\u68A7\u6850\u6E05\u9732\u800C\u751F\uFF0C\u5B88\u7075\u8109\u79D8\u5883\uFF0C\u4E94\u767E\u5E74\u4E00\u6D74\u706B\u6D85\u69C3\u3002\r\n\r\n\u6731\u538C\r\n\u670960%\u7684\u6982\u7387\u95EA\u907F\u73A9\u5BB6\u653B\u51FB\uFF0C\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u5C0F\u6B21\u5C71\u6709\u51F6\u517D\u6731\u538C\uFF0C\u72B6\u5982\u733F\u3001\u767D\u9996\u8D64\u8DB3\uFF0C\u4F34\u767D\u7389\u8D64\u94DC\u800C\u5C45\u3002\u5B83\u4E3A\u5175\u71F9\u4E4B\u5146\uFF0C\u73B0\u8EAB\u5373\u5F15\u5929\u4E0B\u6218\u4E71\u3002\r\n\r\n\u7206\u70B8\u6676\u7C07\r\n\u653B\u51FB\u4F1A\u70B9\u71C3\u6805\u680F\uFF0C\u76F4\u5230\u88AB\u6C34\u70AE\u7184\u706D\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u708E\u706B\u5C71\u85CF\u5947\u6676\uFF0C\u5438\u5730\u8109\u623E\u6C14\u4E0E\u91D1\u77F3\u4E4B\u7CBE\u51DD\u7ED3\u800C\u6210\u3002\u89E6\u78B0\u5373\u7206\u3001\u788E\u6676\u56DB\u6E85\uFF0C\u4E3A\u79D8\u5883\u5929\u7136\u5F02\u602A\uFF0C\u4EA6\u85CF\u7834\u9635\u80FD\u91CF\u3002\r\n\r\n\u7978\u6597\r\n\u884C\u5F84\u540E\u6EDE\u7559\u5730\u9762\u70C8\u706B\uFF0C\u5176\u4F59\u5F02\u517D\u89E6\u78B0\u56DE\u8840\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u538C\u706B\u56FD\u85CF\u51F6\u517D\u7978\u6597\uFF0C\u72B6\u5982\u7384\u72AC\u3001\u904D\u4F53\u6D41\u5149\uFF0C\u4EE5\u706B\u4E3A\u98DF\u3001\u7CAA\u4EA6\u6210\u7130\u3002\u5B83\u76D8\u8E1E\u708E\u706B\u79D8\u5883\uFF0C\u55B7\u7130\u711A\u5C3D\u6765\u8005\u3002\r\n\r\n\u538C\u706B\r\n\u62E5\u6709\u5FA1\u6C34\u7F69\uFF0C\u900F\u652F\u751F\u547D\u53EC\u5524\u706B\u7075\r\n\u300A\u5C71\u6D77\u7ECF\u30FB\u6D77\u5916\u5357\u7ECF\u300B\u8F7D\u538C\u706B\u56FD\u5F02\u517D\u538C\u706B\uFF0C\u72B6\u4F3C\u9ED1\u733F\u3001\u517D\u8EAB\u8986\u6BDB\uFF0C\u4EE5\u70AD\u4E3A\u98DF\u3001\u53E3\u5410\u70C8\u7130\u3002\u76D8\u8E1E\u708E\u706B\u79D8\u5883\u5B88\u62A4\u706B\u6838\u3002\r\n\r\n\r\n\r\n\u6CD5\u5B9D\u6587\u672C\r\n\r\n\u6CA7\u6D77\u8861\r\n\u3010\u4E3B\u52A8\u3011\u70B9\u51FB\u89D2\u8272\u5411\u524D\u65B9\u53D1\u5C04\u6D77\u6D6A\uFF0C\u6240\u6709\u654C\u4EBA\u53D7\u523010\u70B9\u4F24\u5BB3\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u5E7D\u90FD\u5C71\u5BD2\u6E0A\u5B55\u6B64\u7075\u846B\uFF0C\u51DD\u5730\u8109\u9634\u5BD2\u7075\u6DB2\u800C\u6210\uFF0C\u7EA2\u7EF3\u91D1\u94C3\u5C01\u5176\u7075\u529B\uFF0C\u53EF\u50A8\u7075\u6CC9\u5FA1\u90AA\u7130\uFF0C\u662F\u79D8\u5883\u7834\u708E\u7634\u7684\u5173\u952E\u79D8\u5B9D\u3002\r\n\r\n\u78A7\u6CE2\u73CF\r\n\u3010\u88AB\u52A8\u3011\u6BCF\u6B21\u7A7A\u70AE\u4E0B\u4E00\u53D1\u4F24\u5BB3\uFF0B1\uFF0C\u51FB\u4E2D\u602A\u7269\u540E\u91CD\u7F6E\r\n\u300A\u5C71\u6D77\u7ECF\u30FB\u4E2D\u5C71\u7ECF\u300B\u7476\u5C71\u7389\u9AD3\u96D5\u6210\u87AD\u9F99\u4F69\uFF0C\u51DD\u4E0A\u53E4\u6F5C\u9F99\u6C14\u6210\u5F62\uFF0C\u80FD\u9547\u90AA\u715E\u3001\u5F15\u79D8\u5883\u7075\u8109\uFF0C\u662F\u63A2\u9669\u7834\u8FF7\u9635\u7684\u6838\u5FC3\u79D8\u5B9D\u3002\r\n\u5DDD\u6E1F\u5370\r\n\u3010\u88AB\u52A8\u3011\u6BCF3\u6B21\u653B\u51FB\u540E\u4F1A\u4EA7\u751F\u9644\u52A0\u653B\u51FB\uFF0C\u843D\u4E0B\u5370\u7AE0\r\n\u300A\u5C71\u6D77\u7ECF\u30FB\u5317\u6D77\u7ECF\u300B\u8F7D\u5317\u6D77\u7075\u8109\u5B55\u6B64\u9F99\u9F9F\u5B9D\u5668\uFF0C\u51DD\u7384\u9F9F\u6B8B\u9B42\u4E0E\u6C34\u7CBE\u6676\u800C\u6210\uFF0C\u9547\u79D8\u5883\u6C34\u8109\uFF0C\u53EF\u5FA1\u6D2A\u5384\u3001\u7834\u6C34\u969C\uFF0C\u662F\u63A2\u6C34\u5883\u7684\u6838\u5FC3\u79D8\u5B9D\u3002\r\n\r\n\r\n\r\n\u5218\u5F66\u5F64\u3001\u674E\u81EA\u7136\u3001\u9093\u601D\u701A\u3001\u6731\u777F\u3001\u5F20\u8096\u6653\r\n\u5F20\u65ED\u4E1C\r\n\u4E09\u7EF4\u7F8E\u672F\u56E2\u961F\uFF1A\u6C88\u5168\u8FB0\u3001\u4F55\u65B0\u5B87\u3001\u5F20\u6770\r\n\u5468\u51EF\u3001\u9AD8\u57F9\u5C27\uFF0C\u9648\u5EAD\u83F2\uFF0C\u4ED8\u745C\uFF0C\u725B\u7389\u7476\r\n\u52A8\u4F5C\u56E2\u961F\uFF1A\u9E7F\u797A\u6657\u3001\u674E\u79B9\u7476\u3001\u9648\u6CEF\u6C5F\r\n\u5F20\u4EA6\u975E\u3001\u53F6\u598D\u82B3\u3001\u6BDB\u5B87\u6167\r\n\u7279\u6548\u56E2\u961F\uFF1A\u674E\u660C\u4E00\u3001\u8D56\u6210\u9F99\r\n\u5510\u57F9\u96EF\r\n\u7A0B\u5E8F\u56E2\u961F\uFF1A\u738B\u82F1\u5409\u3001\u5F20\u742A\u79C0\u6167\r\n\u5F20\u99A8\u6708\u3001\u90DD\u771F\u61FF\u3001\u6BCD\u6653\u83F2\u3001\u674E\u5353\u6F8E\u3001\u674E\u7490\r\n\u8303\u7EAF\u4F51\r\n\u97F3\u4E50\u97F3\u6548\u7EC4\uFF1A\u738B\u4E49\u535A\r\n=======\u7279\u522B\u9E23\u8C22========\r\n\u90D1\u4F1F\u4E1C\u5148\u751F\u5BF9\u8BE5\u9879\u76EE\u5236\u4F5C\u7684\u5927\u529B\u652F\u6301\uFF01\r\n\r\n\r\n\r\n===\u611F\u8C22\u60A8\u7684\u6E38\u73A9\uFF0C\u795D\u60A8\u6E38\u620F\u6109\u5FEB\uFF01===\u70C8\u71C3\u70E7\u540E\u6D88\u5931\r\n\u5316\u4F5C\u706B\u77E2\u540E\u5C04\u5411\u6805\u680F\u300A\u6D77\u7ECF\u300B\r\n\u8F7D\u4E39\u7A74\u5C71\u98DE\u6709\u795E\u9E1F\u540D\u98CE\u51F0\uFF0C\u96C6\u65E5\r\n\u6708\u4E4B\u534E\u3001\u6C90\u68A7\u6850\u6E05\u9732\u800C\u751F.\u5BF8\u7075\u8109\u79D2\u5883\u3002\r\n\u4E94\u767E\u5E74\u4E00\u6D74\u706B\u661F\u6A0A\u3002\r\n\r\n\u5316\u4F5C\u706B\u7130\u540E\u51B2\u51FB\u6805\u680F\r\n\u7206\u70B8\r\n\u5316\u4F5C\u706B\u7130\u540E\u51B2\u51FB\u6805\u680F\u6805\u680F\uFF0C\u76F4\u5230\u88AB\u6C34\u70AE\u7184\u706D\r\n\u8D70\u8FC7\u7684\u8DEF\u9762\u4F1A\u88AB\u70B9\u71C3\uFF0C\u70B9\u71C3\u7684\u8DEF\u9762\u4F1A\u4F7F\u602A\u7269\u56DE\u8840\r\n\r\n\u7206\u70B8\u6676\u851F\u7206\u70B8\u6676\u851F\r\n\u57FA\u7840\u8840\u91CF\uFF1A3\r\n\u602A\u7269\u7279\u6027\uFF1A\u653B\u51FB\u70B9\u71C3\u6805\u680F\uFF0C\u76F4\u5230\u6C34\u70AE\u706D\u706B\r\n\u300A\u821EUTU\u300B\u300B\r\n\u8F7D\u708E\u706B\u5C71\u85CF\u5947\u6676\u3002\u5438\u5730\u8109\u623F\u6C14\r\n\u4E0E\u91D1\u77F3\u4E4B\u7CBE\u51DD\u7ED3\u800C\u6210\u3002\u89E6\u78B0\u5373\u7206\u3001\u788E\u6676\u5339\r\n\u6E85\uFF0C\u4E3A\u79D8\u5883\u5929\u7136\u5F02\u602A\uFF0C\u4EA6\u85CF\u7834\u9635\u80FD\u91CF\r\n\r\n\u57FA\u7840\u8840\u91CF\uFF1A3\u5C0F\u706B\u602A\r\n\u706B\u51E4\u51F0\r\n\u6731\u538C\r\n\u7206\u70B8\u6676\u7C07\r\n\u7978\u6597\u602A\u7269\u7279\u6027\uFF1A\u653B\u51FB\u70B9\u71C3\u6805\u680F\uFF0C\u76F4\u5230\u6C34\u70AE\u706D\u706B\r\n\u300A\u5C71\u6D77\u7ECF\u300B\u8F7D\u708E\u706B\u5C71\u85CF\u5947\u6676\u3002\u5438\u5730\u8109\u623F\u6C14\u4E0E\u91D1\u77F3\u4E4B\u7CBE\u51DD\u7ED3\u800C\u6210\u3002\u89E6\u78B0\u5373\u7206\u3001\u788E\u6676\u5339\u6E85\uFF0C\u4E3A\u79D8\u5883\u5929\u7136\u5F02\u602A\uFF0C\u4EA6\u85CF\u7834\u9635\u80FD\u91CF\u706B\u82D7\u72B6\u57FA\u7840\u5C0F\u706B\u602A\t\u4E00\u7C07\u706B\u82D7\r\n\u6BD5\u65B9\t\u71C3\u70E7\u7740\u706B\u7130\u7684\u9E1F\r\n\u6731\u538C\t\u4E00\u53EA\u8EAB\u4E0A\u5E26\u706B\u82D7\u7684\u7334\u5B50\r\n\u7EA2\u8272\u77FF\u77F3\t\u7531\u706B\u7130\u7ED3\u6676\u6784\u6210\u7684\u7C7B\u77FF\u77F3\u6676\u4F53\u72B6\u602A\u7269\r\n\u7978\u6597\t\u5916\u5F62\u5982\u9ED1\u72AC\uFF0C\u4F46\u4EE5\u706B\u7130\u4E3A\u98DF\u3002\u8EAB\u4F53\u7531\u6697\u7EA2\u8272\u70BD\u70AD\u6784\u6210\uFF0C\u5954\u8DD1\u65F6\u706B\u661F\u56DB\u5C04\r\n\u5FEB\u901F\u88C5\u586B\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+15%  
      \r\n\u66B4\u51FB\u4F24\u5BB3+10%\r\n\u653B\u51FB\u95F4\u9694+5%\u653B\u51FB\u529B\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u6570\u91CF\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u5927\u5C0F\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u7A7F\u900F\r\n\u66B4\u51FB\u7387+10%\r\n\u653B\u51FB\u529B+3\r\n\u5B50\u5F39\u5927\u5C0F+15%\r\n\u653B\u51FB\u529B+3\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6-10%\r\n\u66B4\u51FB\u4F24\u5BB3+20%\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+5%\r\n\u5B50\u5F39\u5927\u5C0F-10%\r\n\u6563\u5E03\u8303\u56F4max-15%\r\n\u8840\u91CF-5\r\n\u5B50\u5F39\u4E0A\u9650+3\r\n\u8840\u91CF+10\r\n\u6563\u5E03\u8303\u56F4min+10%\r\n\u653B\u51FB+5\r\n\u653B\u51FB\u95F4\u9694+5%\r\n\u5B50\u5F39\u5927\u5C0F-5%\r\n\u653B\u51FB\u95F4\u9694-15%\r\n\u5B50\u5F39\u4E0A\u9650+1\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6+15%\r\n\u66B4\u51FB\u4F24\u5BB3+10%\r\n\u653B\u51FB\u95F4\u9694+5%\r\n\u653B\u51FB\u95F4\u9694\r\n\u5B50\u5F39\u4E0A\u9650\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6\r\n\u5B50\u5F39\u5927\u5C0F\r\n\u6563\u5E03\u8303\u56F4max\u602A\u7269\u6BCF\u6B21\u53D7\u51FB\u670920%\u6982\u7387\u5728\u4E00\u4E2A\u521D\u59CB\u65B9\u5411\u53D1\u5C041\u9897\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\r\n\u5B50\u5F39\u4E0A\u9650-1\r\n\u968F\u673A\u4E00\u4E2A\u521D\u59CB\u65B9\u5411\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u6570\u91CF+1\r\n\u66B4\u51FB\u7387+10%\r\n\u5C06\u6240\u6709\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u5411\u968F\u673A\u540C\u4E00\u65B9\u5411\u53D1\u5C04\r\n\u6563\u5E03\u8303\u56F4max+10%\r\n\u5B50\u5F39\u5927\u5C0F-15%\r\n\u5F53\u573A\u4E0A\u5B58\u572810\u4E2A\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u65F6\uFF0C\u4E0B\u4E00\u6B21\u653B\u51FB70%\u4E0D\u6D88\u8017\u5F39\u836F\r\n\u653B\u51FB\u95F4\u9694-15%\r\n\u66B4\u51FB\u4F24\u5BB3+10%\r\n\u4E0B\u4E00\u6B21\u9009\u5361\u65F6\u53EF\u4EE5\u9009\u62E93\u6B21\r\n\u8840\u91CF+5\r\n\u56DE\u590D50%\u8840\u91CF\r\n\u6563\u5E03\u8303\u56F4min+20%\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F3920%\u643A\u5E26\u96F7\u7535\uFF0C\u51FB\u4E2D\u706B\u602A\u540E\u9020\u6210\u8303\u56F4\u7206\u70B8\uFF0C\u7206\u70B8\u4F24\u5BB3\u4E3A\u5B50\u5F39\u768410%\r\n\u6563\u5E03\u8303\u56F4min-20%\r\n\u66B4\u51FB\u7387+10%\r\n\u6700\u540E2\u9897\u7684\u6C34\u7403\u843D\u70B9\u5C06\u5404\u751F\u6210\u4E00\u4E2A\u6700\u591A\u5B58\u57283s\u7684\u3010\u951A\u70B9\u3011\r\n\u6563\u5E03\u8303\u56F4max-10%\u731B\u51FB\r\n\r\n\u8D85\u5927\u5F39\r\n\r\n\r\n\u7CBE\u5999\u5B50\u5F39\r\n\r\n\r\n\u7CBE\u51C6\r\n\r\n\u6269\u5BB9\u5F39\u5939\r\n\r\n\r\n\u5F3A\u653B\r\n\r\n\r\n\u9AD8\u901F\u541F\u5531\r\n\r\n\u5FEB\u901F\u88C5\u586B\r\n\r\n\r\n\u538B\u7F29\u6C34\u5F39\r\n\r\n\u66F4\u591A\u98DE\u5F39\r\n\r\n\u540C\u5411\u98DE\u5F39\r\n\r\n\r\n\u98DE\u5F39\u56DE\u6536\r\n\r\n\r\n\u65E0\u4E2D\u751F\u6709\r\n\r\n\u75AF\u72C2\u94BB\u77F3\r\n\r\n\u96F7\u7F5A\r\n\r\n\r\n\u8FDE\u8FDE\u770B\r\n\r\n\r\n\u6751\u5E84\u82F1\u96C4\r\n\r\n\r\n\r\n\u597D\u591A\u4EBA\u554A\r\n\r\n\u602A\u7269\u53D7\u51FB\u6982\u7387\u53D1\u5C04\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\r\nBC-1\r\n\u589E\u52A0\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u6570\u91CF\r\nCR+10%\r\n\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u65B9\u5411\u7EDF\u4E00\r\nSM+10%\r\nBS-15%\r\n\u6709\u591A\u4E2A\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u65F6\uFF0C\u6982\u7387\u4E0D\u8017\u5F39\r\nAI-15%\r\nCD+10%\r\n\u4E0B\u4E00\u6B21\u9009\u5361\u65F6\u53EF\u4EE5\u9009\u62E93\u6B21\r\nHP+10\r\n\u56DE\u590D50%\u8840\u91CF\r\nSN+20%\r\n\u602A\u7269\u6B7B\u4EA1\u5206\u88C2\u5B50\u5F39\u5E26\u70B8\u96F7\r\nSN-20%\r\nCR+10%\r\n\u653B\u51FB\u843D\u70B9\u751F\u6210\u951A\u70B9\r\nSM-10%\u53D1\u5C04\u6C34\u70AE\t\u9AD8\u989D\u63D0\u5347\u52A0\u6210\t\u66B4\u51FB\u7387+50%\u4FEE\u6539\u3001\u66B4\u51FB\u4F24\u5BB3+50%\u4FEE\u6539\t\"\u653B\u51FB\u529B\uFF1A2\r\n\u653B\u51FB\u95F4\u9694\uFF1A10\r\n\u5B50\u5F39\u4E0A\u9650\uFF1A5\r\n\u5B50\u5F39\u56DE\u590D\u901F\u5EA6\uFF1A10\r\n\u5B50\u5F39\u5927\u5C0F\uFF1A5\r\n\u6805\u680F\u8840\u9